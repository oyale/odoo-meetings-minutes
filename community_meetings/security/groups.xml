<odoo>
    <record id="module_category_meeting_reader" model="ir.module.category">
        <field name="name">Meetings</field>
        <field name="parent_id" ref="base.module_category_services"/>
        <field name="sequence">40</field>
    </record>
    <record id="module_category_meeting_editor" model="ir.module.category">
        <field name="name">Meetings</field>
        <field name="parent_id" ref="base.module_category_services"/>
        <field name="sequence">41</field>
    </record>
    <record id="module_category_meeting_approver" model="ir.module.category">
        <field name="name">Meetings</field>
        <field name="parent_id" ref="base.module_category_services"/>
        <field name="sequence">42</field>
    </record>
    <record id="module_category_meeting_manager" model="ir.module.category">
        <field name="name">Meetings</field>
        <field name="parent_id" ref="base.module_category_services"/>
        <field name="sequence">43</field>
    </record>
    <record id="group_agenda_proposer" model="res.groups">
        <field name="name">Meeting Agenda Proposer</field>
        <field name="comment">Submit scoped agenda proposals without meeting access.</field>
    </record>
    <record id="group_meeting_reader" model="res.groups">
        <field name="name">Meeting Reader</field>
        <field name="category_id" ref="module_category_meeting_reader"/>
    </record>
    <record id="group_meeting_editor" model="res.groups">
        <field name="name">Meeting Editor</field>
        <field name="category_id" ref="module_category_meeting_editor"/>
        <field name="implied_ids" eval="[(4, ref('group_meeting_reader'))]"/>
    </record>
    <record id="group_meeting_approver" model="res.groups">
        <field name="name">Meeting Approver</field>
        <field name="category_id" ref="module_category_meeting_approver"/>
        <field name="implied_ids" eval="[(4, ref('group_meeting_reader'))]"/>
    </record>
    <record id="group_meeting_manager" model="res.groups">
        <field name="name">Meeting Manager</field>
        <field name="category_id" ref="module_category_meeting_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_meeting_editor')), (4, ref('group_meeting_approver'))]"/>
    </record>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_agenda_proposer'))]"/>
    </record>
</odoo>
