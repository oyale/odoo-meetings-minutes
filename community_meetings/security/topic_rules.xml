<odoo>
<record id="rule_topic_company" model="ir.rule"><field name="name">Point companies</field><field name="model_id" ref="model_community_meeting_topic"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_topic_reader" model="ir.rule"><field name="name">Points of visible meetings</field><field name="model_id" ref="model_community_meeting_topic"/><field name="groups" eval="[(4, ref('group_meeting_reader'))]"/><field name="domain_force">['|','|','|','|',('create_uid','=',user.id),('all_participation_ids.meeting_id.organizer_id','=',user.id),('all_participation_ids.meeting_id.secretary_id','=',user.id),('all_participation_ids.meeting_id.editor_user_ids','in',user.id),('all_participation_ids.meeting_id.reader_user_ids','in',user.id)]</field><field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
<record id="rule_topic_editor" model="ir.rule"><field name="name">Points of editable meetings</field><field name="model_id" ref="model_community_meeting_topic"/><field name="groups" eval="[(4, ref('group_meeting_editor'))]"/><field name="domain_force">['|','|','|',('create_uid','=',user.id),('all_participation_ids.meeting_id.organizer_id','=',user.id),('all_participation_ids.meeting_id.secretary_id','=',user.id),('all_participation_ids.meeting_id.editor_user_ids','in',user.id)]</field></record>
<record id="rule_topic_editor_proposals" model="ir.rule"><field name="name">Editable series proposals</field><field name="model_id" ref="model_community_meeting_topic"/><field name="groups" eval="[(4, ref('group_meeting_editor'))]"/><field name="domain_force">['&amp;',('proposal_status','=','submitted'),('series_id.coordinator_user_ids','in',user.id)]</field><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
<record id="rule_topic_manager" model="ir.rule"><field name="name">Manage points</field><field name="model_id" ref="model_community_meeting_topic"/><field name="groups" eval="[(4, ref('group_meeting_manager'))]"/><field name="domain_force">[(1,'=',1)]</field></record>
<record id="rule_topic_proposer_own" model="ir.rule"><field name="name">Own submitted proposals</field><field name="model_id" ref="model_community_meeting_topic"/><field name="groups" eval="[(4, ref('group_agenda_proposer'))]"/><field name="domain_force">[('submitted_by_user_id', '=', user.id), ('proposal_status', '=', 'submitted')]</field><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/></record>
</odoo>