<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_community_meeting_series_list" model="ir.ui.view">
        <field name="name">community.meeting.series.list</field>
        <field name="model">community.meeting.series</field>
        <field name="arch" type="xml">
            <list default_order="name" js_class="community_meeting_series_list">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="coordinator_user_ids" widget="many2many_tags"/>
                <field name="carryover_policy"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_community_meeting_series_form" model="ir.ui.view">
        <field name="name">community.meeting.series.form</field>
        <field name="model">community.meeting.series</field>
        <field name="arch" type="xml">
            <form string="Meeting Series">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_new_meeting" type="object" class="oe_stat_button" icon="fa-plus">
                            <span class="o_stat_text">New Meeting</span>
                        </button>
                        <button name="action_propose_point" type="object" class="oe_stat_button" icon="fa-lightbulb-o" groups="base.group_user">
                            <span class="o_stat_text">Propose a point</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Series name"/></h1>
                    </div>
                    <group>
                        <group name="identity" string="What">
                            <field name="meeting_kind_id" help="Type of meetings this series holds."/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" widget="boolean_toggle" help="Archived series keep their meetings but disappear from lists and menus."/>
                        </group>
                        <group name="people" string="People">
                            <field name="coordinator_user_ids" widget="many2many_tags" help="People responsible for preparing the meetings of this series."/>
                            <field name="attendee_partner_ids" widget="many2many_tags" help="People invited to every new meeting of this series; you can still change attendees per meeting."/>
                        </group>
                    </group>
                    <group string="Purpose">
                        <field name="description" nolabel="1" placeholder="What kind of series is this?"/>
                    </group>
                    <notebook>
                        <page string="Meetings" name="meetings">
                            <field name="meeting_ids" readonly="1">
                                <list create="0" edit="0" delete="0" default_order="start_datetime desc">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="start_datetime"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Scheduling" name="scheduling">
                            <group>
                                <group>
                                    <field name="duration_hours" widget="float_time" help="Planned length of each meeting of this series."/>
                                    <field name="timezone" help="Timezone used to propose the next meeting date."/>
                                </group>
                                <group>
                                    <field name="meeting_name_pattern" placeholder="{date} {series}" help="New meetings are named with this pattern. Use {date} for the meeting date and {series} for the series name."/>
                                </group>
                            </group>
                        </page>
                        <page string="Recurring agenda" name="recurring_agenda">
                            <p class="text-muted">
                                These templates are proposed when preparing a meeting. Each selected point becomes an independent occurrence; skipping one meeting does not remove the template.
                            </p>
                            <field name="recurring_point_ids" context="{'default_series_id': id}">
                                <list default_order="sequence, id" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="active" widget="boolean_toggle"/>
                                    <field name="name"/>
                                    <field name="agenda_type_id"/>
                                    <field name="priority"/>
                                    <field name="estimated_minutes"/>
                                    <field name="show_previous_discussion" optional="show" invisible="agenda_type_id.behavior in ['minutes_approval', 'next_meeting']"/>
                                </list>
                                <form string="Recurring agenda point">
                                    <sheet>
                                        <group>
                                            <field name="series_id" invisible="1"/>
                                            <field name="name"/>
                                            <field name="agenda_type_id" widget="meeting_agenda_type_rich"/>
                                            <field name="priority"/>
                                            <field name="estimated_minutes" widget="meeting_point_minutes"/>
                                            <field name="presenter_partner_id"/>
                                            <field name="show_previous_discussion" invisible="agenda_type_id.behavior in ['minutes_approval', 'next_meeting']"/>
                                            <div class="text-muted" invisible="agenda_type_id.behavior in ['minutes_approval', 'next_meeting']">New occurrences show earlier discussion as read-only context. Changing this setting affects future occurrences only.</div>
                                            <field name="active" widget="boolean_toggle"/>
                                            <field name="sequence"/>
                                        </group>
                                        <group string="Description">
                                            <field name="description" nolabel="1" widget="html"/>
                                        </group>
                                        <group string="Follow-ups" invisible="agenda_type_id.behavior != 'todo'">
                                            <field name="followup_allowed_kinds" widget="many2many_tags"/>
                                            <field name="followup_default_kind"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Agenda structure" name="structure">
                            <group>
                                <group>
                                    <field name="has_minutes_approval_point"/>
                                    <field name="has_next_meeting_point"/>
                                </group>
                                <group>
                                    <field name="next_meeting_rule" invisible="not has_next_meeting_point"/>
                                    <field name="next_meeting_weekday" invisible="next_meeting_rule != 'weekday'"/>
                                    <field name="next_meeting_day_of_month" invisible="next_meeting_rule != 'day_of_month'"/>
                                    <field name="next_meeting_interval_days" invisible="next_meeting_rule != 'interval_days'"/>
                                </group>
                            </group>
                            <div class="text-muted" invisible="not has_next_meeting_point">
                                Every meeting of this series starts with a minutes-approval point (if enabled) and ends with a next-meeting point. The default rule above pre-fills its proposed date: next weekday (e.g. always Tuesday), a fixed day of the month, or a fixed number of days after this meeting.
                            </div>
                        </page>
                        <page string="Policies" name="policies">
                            <group>
                                <group string="Unfinished points" name="carryover">
                                    <field name="carryover_policy" widget="radio" options="{'horizontal': true}"/>
                                    <div class="text-muted">
                                        Review: the next meeting decides which points to continue. Automatic: unfinished points continue without asking. Manual: someone moves each point explicitly.
                                    </div>
                                </group>
                                <group string="Adding points" name="add_point_group">
                                    <field name="add_point_policy" widget="radio" options="{'horizontal': true}"/>
                                    <div class="text-muted" invisible="add_point_policy == 'draft'">
                                        Draft only: points can be added while preparing the meeting. Before it starts: also once it is scheduled, until it begins. While it runs: also while the meeting is in progress, until it finishes.
                                    </div>
                                    <div class="text-muted" invisible="add_point_policy != 'draft'">
                                        Points can only be added while the meeting is a draft.
                                    </div>
                                </group>
                                <group string="Time tracking" name="time_tracking_group">
                                    <field name="time_tracking" widget="radio" options="{'horizontal': true}"/>
                                    <div class="text-muted" invisible="time_tracking != 'inherit'">
                                        Company default: <field name="company_meeting_time_tracking" widget="boolean_toggle" readonly="1"/> (change it in Settings → Meetings → Time tracking).
                                    </div>
                                    <div class="text-muted" invisible="time_tracking == 'inherit'">
                                        When off, meetings of this series have no start/pause timers: the live meeting is editable from the start and only the actual finish is recorded.
                                    </div>
                                </group>
                                <group string="Point estimates" name="point_estimates" colspan="2">
                                    <group>
                                        <field name="default_estimated_minutes" help="Estimated minutes pre-filled for new points of this series; leave empty to use the company default."/>
                                        <field name="company_point_estimated_minutes" readonly="1"/>
                                    </group>
                                    <div class="text-muted">
                                        Minutes-approval points reserve 5 minutes per pending acta and next-meeting points 5 minutes, regardless of this value.
                                    </div>
                                </group>
                                <group string="Role names" name="role_labels" colspan="2">
                                    <group>
                                        <field name="coordinator_label"/>
                                        <field name="secretary_label"/>
                                    </group>
                                    <div class="text-muted">
                                        Optional overrides of the default role names shown on meetings (Settings → Meetings → Role names). Leave empty to use those.
                                    </div>
                                </group>
                                <group string="Follow-ups" name="followups" colspan="2">
                                    <group>
                                        <field name="followup_allowed_kinds" widget="many2many_tags" help="Follow-up types new points of this series may use."/>
                                        <field name="followup_default_kind" help="Follow-up type pre-selected when adding a point to a meeting of this series."/>
                                    </group>
                                    <group>
                                        <field name="default_activity_type_id" help="Activity type used when a follow-up is recorded as an Odoo activity."/>
                                    </group>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_series_wizard" model="ir.ui.view">
        <field name="name">community.meeting.series.wizard</field>
        <field name="model">community.meeting.series.wizard</field>
        <field name="arch" type="xml">
            <form string="New Meeting Series" class="o_meeting_series_wizard">
                <header><field name="step" widget="statusbar"/></header>
                <field name="created_series_id" invisible="1"/>
                <div class="o_meeting_series_step" invisible="step != 'basics'">
                    <div class="o_meeting_wizard_intro"><h2>Set up your meeting series</h2><p>Give it a clear name, choose its coordinators, and decide how unfinished points continue.</p></div>
                    <div class="o_meeting_series_active">
                        <label class="o_meeting_series_active_hitarea" for="active" string=""/>
                        <div class="o_meeting_series_active_copy"><h3>Series is active</h3><p>Active series are available when preparing meetings.</p></div>
                        <field name="active" widget="boolean_toggle" nolabel="1"/>
                    </div>
                    <div class="o_meeting_series_panel o_meeting_series_identity">
                        <h3>Series identity</h3>
                        <group>
                            <field name="name" placeholder="Series name" class="o_meeting_series_name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="coordinator_user_ids" widget="many2many_tags"/>
                        </group>
                        <p class="o_meeting_series_hint">Coordinators are responsible for preparing this series. If left empty, you become its first coordinator.</p>
                    </div>
                    <div class="o_meeting_series_panel">
                        <h3>Unfinished points</h3>
                        <group><field name="carryover_policy" widget="radio" options="{'horizontal': True}" class="o_meeting_series_carryover_policy o_meeting_series_carryover_radios"/></group>
                        <p class="o_meeting_series_hint">Review lets you decide which points continue while preparing the next meeting. Automatic carries unfinished points forward without asking. With Manual, you must find and move each point yourself; it will never be suggested automatically.</p>
                    </div>
                </div>
                <div class="o_meeting_series_step" invisible="step != 'schedule'">
                    <div class="o_meeting_wizard_intro"><h2>Set the meeting defaults</h2><p>These are suggestions for future meetings; you can adjust each meeting later.</p></div>
                    <div class="o_meeting_series_panel">
                        <h3>Time and title</h3>
                        <group>
                            <field name="timezone"/>
                            <field name="duration_hours" widget="float_time"/>
                            <field name="meeting_name_pattern" placeholder="{date} {series}"/>
                        </group>
                        <p class="o_meeting_series_hint">The time zone is used to suggest the next date. In the title pattern, {date} is the meeting date and {series} is this series name.</p>
                    </div>
                    <div class="o_meeting_series_panel">
                        <h3>People to invite</h3>
                        <group><field name="attendee_partner_ids" widget="many2many_tags"/></group>
                        <p class="o_meeting_series_hint">These people are suggested for each new meeting. You can change the attendees for an individual meeting.</p>
                    </div>
                </div>
                <div class="o_meeting_series_step" invisible="step != 'structure'">
                    <div class="o_meeting_wizard_intro"><h2>Set agenda and meeting rules</h2><p>Choose when points can be added and set the agenda defaults. You can define recurring points from the series after it is created.</p></div>
                    <div class="o_meeting_series_panel">
                        <h3>Meeting controls</h3>
                        <div class="o_meeting_series_policy">
                            <div class="o_meeting_series_policy_header">
                                <h4>Time tracking</h4>
                                <div class="o_meeting_series_policy_toggle">
                                    <field name="use_company_time_tracking" widget="boolean_toggle" nolabel="1"/>
                                    <label for="use_company_time_tracking" string="Company default"/>
                                </div>
                            </div>
                            <field name="time_tracking" invisible="1"/>
                            <p class="o_meeting_series_hint" invisible="not use_company_time_tracking">Tracks meeting and agenda-point time. This series inherits the company setting. Turn off the switch to choose a value for this series.</p>
                            <field name="time_tracking_override" widget="radio" options="{'horizontal': True}" invisible="use_company_time_tracking" nolabel="1"/>
                        </div>
                        <div class="o_meeting_series_policy">
                            <div class="o_meeting_series_policy_header">
                                <h4>Adding points</h4>
                                <div class="o_meeting_series_policy_toggle">
                                    <field name="use_company_add_point_policy" widget="boolean_toggle" nolabel="1"/>
                                    <label for="use_company_add_point_policy" string="Company default"/>
                                </div>
                            </div>
                            <field name="add_point_policy" invisible="1"/>
                            <p class="o_meeting_series_hint" invisible="not use_company_add_point_policy">Controls when people can add agenda points. This series inherits the company rule. Turn off the switch to choose a value for this series.</p>
                            <field name="add_point_policy_override" widget="radio" options="{'horizontal': True}" invisible="use_company_add_point_policy" nolabel="1"/>
                        </div>
                    </div>
                    <div class="o_meeting_series_panel">
                        <h3>Agenda defaults</h3>
                        <div class="o_meeting_series_estimate">
                            <div class="o_meeting_series_policy_header">
                                <h4>Default estimate per agenda point</h4>
                                <div class="o_meeting_series_policy_toggle">
                                    <field name="use_company_estimated_minutes" widget="boolean_toggle" nolabel="1"/>
                                    <label for="use_company_estimated_minutes" string="Company default"/>
                                </div>
                            </div>
                            <p class="o_meeting_series_hint" invisible="not use_company_estimated_minutes">Suggests a duration for new agenda points. This series inherits the company estimate. Turn off the switch to set an estimate for this series.</p>
                            <group invisible="use_company_estimated_minutes"><field name="default_estimated_minutes" widget="meeting_point_minutes" nolabel="1"/></group>
                            <p class="o_meeting_series_hint" invisible="use_company_estimated_minutes">This estimate is suggested for new agenda points. Each point can have its own estimate.</p>
                        </div>
                        <h3 class="o_meeting_series_subheading">Automatic points</h3>
                        <div class="o_meeting_series_agenda_options">
                            <div class="o_meeting_series_agenda_option">
                                <div class="o_meeting_series_agenda_option_header">
                                    <label class="o_meeting_series_agenda_option_label" for="has_minutes_approval_point"><strong>Minutes approval</strong><span>Added to every meeting in this series. Editors can approve earlier minutes during a live meeting; approvers can do so while preparing minutes for an offline meeting.</span></label>
                                    <field name="has_minutes_approval_point" widget="boolean_toggle" nolabel="1"/>
                                </div>
                            </div>
                            <div class="o_meeting_series_agenda_option">
                                <div class="o_meeting_series_agenda_option_header">
                                    <label class="o_meeting_series_agenda_option_label" for="has_next_meeting_point"><strong>Next meeting date</strong><span>Adds a point to agree on the next date at every meeting in this series.</span></label>
                                    <field name="has_next_meeting_point" widget="boolean_toggle" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="o_meeting_series_panel" invisible="not has_next_meeting_point">
                        <h3>Suggested next date</h3>
                        <label for="next_meeting_rule" string="Calculate the next date according to"/>
                        <group class="o_meeting_series_next_date_rules">
                            <field name="next_meeting_rule" widget="radio" options="{'horizontal': True}" class="o_meeting_series_next_date_radios" nolabel="1"/>
                            <field name="next_meeting_weekday" widget="radio" options="{'horizontal': True}" class="o_meeting_series_weekday_radios" invisible="next_meeting_rule != 'weekday'"/>
                            <field name="next_meeting_day_of_month" invisible="next_meeting_rule != 'day_of_month'"/>
                            <field name="next_meeting_interval_days" invisible="next_meeting_rule != 'interval_days'"/>
                        </group>
                        <p class="o_meeting_series_hint">Choose a rule to reveal its value. The suggested date appears in the next-meeting agenda point; it does not schedule a meeting automatically.</p>
                    </div>
                    <div name="project_wizard_configuration"/>
                </div>
                <div class="o_meeting_series_step" invisible="step != 'review'">
                    <div class="o_meeting_wizard_intro"><h2>Review the series</h2><p>Check the choices below. Use Back to change anything before creating the series.</p></div>
                    <div class="o_meeting_series_panel">
                        <h3>Identity and people</h3>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="coordinator_user_ids" widget="many2many_tags" readonly="1"/>
                            <field name="attendee_partner_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </div>
                    <div class="o_meeting_series_panel">
                        <h3>Meeting defaults</h3>
                        <group>
                            <field name="timezone" readonly="1"/>
                            <field name="duration_hours" widget="float_time" readonly="1"/>
                            <field name="meeting_name_pattern" readonly="1"/>
                            <field name="use_company_estimated_minutes" readonly="1"/>
                            <field name="default_estimated_minutes" readonly="1" invisible="use_company_estimated_minutes"/>
                        </group>
                    </div>
                    <div class="o_meeting_series_panel">
                        <h3>Agenda and rules</h3>
                        <group>
                            <field name="carryover_policy" readonly="1"/>
                            <field name="time_tracking" readonly="1"/>
                            <field name="add_point_policy" readonly="1"/>
                            <field name="has_minutes_approval_point" readonly="1"/>
                            <field name="has_next_meeting_point" readonly="1"/>
                            <field name="next_meeting_rule" readonly="1" invisible="not has_next_meeting_point"/>
                            <field name="next_meeting_weekday" readonly="1" invisible="not has_next_meeting_point or next_meeting_rule != 'weekday'"/>
                            <field name="next_meeting_day_of_month" readonly="1" invisible="not has_next_meeting_point or next_meeting_rule != 'day_of_month'"/>
                            <field name="next_meeting_interval_days" readonly="1" invisible="not has_next_meeting_point or next_meeting_rule != 'interval_days'"/>
                        </group>
                    </div>
                    <div name="project_wizard_review"/>
                </div>
                <footer>
                    <button name="action_back" type="object" string="Back" invisible="step == 'basics'"/>
                    <button name="action_next" type="object" string="Next" class="btn-primary" invisible="step == 'review'"/>
                    <button name="action_finish" type="object" string="Create Series" class="btn-primary" invisible="step != 'review'"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_community_meeting_series" model="ir.actions.act_window">
        <field name="name">Meeting Series</field>
        <field name="res_model">community.meeting.series</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_community_meeting_series" name="Meeting Series"
        parent="community_meetings.menu_community_meetings_root"
        action="action_community_meeting_series" sequence="15"
        groups="community_meetings.group_meeting_editor"/>
</odoo>
