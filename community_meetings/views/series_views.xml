<odoo>
    <record id="view_community_meeting_series_list" model="ir.ui.view">
        <field name="name">community.meeting.series.list</field>
        <field name="model">community.meeting.series</field>
        <field name="arch" type="xml">
            <list default_order="name" js_class="community_meeting_series_list">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="coordinator_user_ids" widget="many2many_tags"/>
                <field name="carryover_policy"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_community_meeting_series_form" model="ir.ui.view">
        <field name="name">community.meeting.series.form</field>
        <field name="model">community.meeting.series</field>
        <field name="arch" type="xml">
            <form string="Meeting Series">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_new_meeting" type="object" class="oe_stat_button" icon="fa-plus">
                            <span class="o_stat_text">New Meeting</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Series name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="meeting_kind"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="coordinator_user_ids" widget="many2many_tags"/>
                            <field name="carryover_policy"/>
                        </group>
                    </group>
                    <group string="Agenda structure">
                        <group>
                            <field name="has_minutes_approval_point"/>
                            <field name="has_next_meeting_point"/>
                        </group>
                        <group>
                            <field name="next_meeting_rule"/>
                            <field name="timezone"/>
                            <field name="next_meeting_weekday" invisible="next_meeting_rule != 'weekday'"/>
                            <field name="next_meeting_day_of_month" invisible="next_meeting_rule != 'day_of_month'"/>
                            <field name="next_meeting_interval_days" invisible="next_meeting_rule != 'interval_days'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Meetings">
                            <field name="meeting_ids" readonly="1">
                                <list create="0" edit="0" delete="0" default_order="start_datetime desc">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="start_datetime"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_series_wizard" model="ir.ui.view">
        <field name="name">community.meeting.series.wizard</field>
        <field name="model">community.meeting.series.wizard</field>
        <field name="arch" type="xml">
            <form string="New Meeting Series">
                <header><field name="step" widget="statusbar"/></header>
                <field name="created_series_id" invisible="1"/>
                <group invisible="step != 'basics'">
                    <field name="name" placeholder="Series name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="coordinator_user_ids" widget="many2many_tags"/>
                    <field name="carryover_policy"/>
                    <field name="active"/>
                </group>
                <group invisible="step != 'schedule'">
                    <field name="timezone"/>
                    <field name="duration_hours" widget="float_time"/>
                    <field name="attendee_partner_ids" widget="many2many_tags"/>
                    <field name="meeting_name_pattern" placeholder="{date} {series}"/>
                </group>
                <group invisible="step != 'structure'">
                    <field name="has_minutes_approval_point"/>
                    <field name="has_next_meeting_point"/>
                    <field name="next_meeting_rule"/>
                    <field name="next_meeting_weekday" invisible="next_meeting_rule != 'weekday'"/>
                    <field name="next_meeting_day_of_month" invisible="next_meeting_rule != 'day_of_month'"/>
                    <field name="next_meeting_interval_days" invisible="next_meeting_rule != 'interval_days'"/>
                </group>
                <group invisible="step != 'review'">
                    <field name="name" readonly="1"/>
                    <field name="company_id" readonly="1"/>
                    <field name="coordinator_user_ids" widget="many2many_tags" readonly="1"/>
                    <field name="carryover_policy" readonly="1"/>
                    <field name="timezone" readonly="1"/>
                    <field name="duration_hours" widget="float_time" readonly="1"/>
                    <field name="attendee_partner_ids" widget="many2many_tags" readonly="1"/>
                    <field name="meeting_name_pattern" readonly="1"/>
                    <field name="has_minutes_approval_point" readonly="1"/>
                    <field name="has_next_meeting_point" readonly="1"/>
                    <field name="next_meeting_rule" readonly="1"/>
                </group>
                <footer>
                    <button name="action_back" type="object" string="Back" invisible="step == 'basics'"/>
                    <button name="action_next" type="object" string="Next" class="btn-primary" invisible="step == 'review'"/>
                    <button name="action_finish" type="object" string="Create Series" class="btn-primary" invisible="step != 'review'"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_community_meeting_series" model="ir.actions.act_window">
        <field name="name">Meeting Series</field>
        <field name="res_model">community.meeting.series</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_community_meeting_series" name="Meeting Series"
        parent="community_meetings.menu_community_meetings_root"
        action="action_community_meeting_series" sequence="15"
        groups="community_meetings.group_meeting_editor"/>
</odoo>
