<odoo>
    <record id="view_topic_form" model="ir.ui.view">
        <field name="name">community.meeting.topic.form</field><field name="model">community.meeting.topic</field>
        <field name="arch" type="xml"><form string="Point"><header><button name="action_copy_to_series" type="object" string="Copy to another series" groups="community_meetings.group_meeting_editor"/></header><sheet>
            <h1><field name="name"/></h1>
            <group><field name="agenda_type_id" widget="meeting_agenda_type"/><field name="state" readonly="1"/><field name="outcome" readonly="1"/><field name="postponed" readonly="1"/><field name="presenter_partner_id"/><field name="priority"/><field name="deadline"/><field name="estimated_minutes"/><field name="series_id" readonly="1"/></group>
            <field name="description" widget="html"/>
            <group string="Advanced follow-up options"><field name="followup_allowed_kinds" widget="many2many_tags"/><field name="followup_default_kind"/></group>
            <group string="Related"><field name="origin_topic_id" readonly="1" invisible="not origin_topic_id"/><field name="related_topic_ids" widget="many2many_tags" domain="[('company_id', '=', company_id), ('id', '!=', id)]"/></group>
            <field name="participation_ids" readonly="1"><list><field name="meeting_id"/><field name="disposition"/></list></field>
        </sheet><chatter/></form></field>
    </record>
    <record id="view_topic_copy_wizard" model="ir.ui.view">
        <field name="name">community.meeting.topic.copy.wizard</field><field name="model">community.meeting.topic.copy.wizard</field>
        <field name="arch" type="xml"><form string="Copy Point to Another Series"><group><field name="topic_id"/><field name="destination_series_id"/></group>
        <footer><button name="action_copy" type="object" string="Copy" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field>
    </record>
    <record id="view_meeting_preparation" model="ir.ui.view">
        <field name="name">community.meeting.preparation</field><field name="model">community.meeting</field><field name="inherit_id" ref="view_community_meeting_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before"><div class="alert alert-info" groups="community_meetings.group_meeting_editor" invisible="not pending_carryover_ids"><strong>Points to continue</strong><field name="pending_carryover_ids" readonly="1" nolabel="1"><list create="0" edit="0" delete="0"><field name="origin_name"/><field name="origin_meeting_id"/><field name="reason"/><button name="action_accept" type="object" string="Accept"/><button name="action_dismiss" type="object" string="Dismiss"/></list></field></div></xpath>
            <field name="end_datetime" position="after"><field name="duration_hours" widget="float_time"/></field>
            <xpath expr="//field[@name='agenda_item_ids']/list" position="attributes"><attribute name="create">0</attribute></xpath>
            <field name="agenda_item_ids" position="before"><field name="agenda_over_budget" invisible="1"/><div class="alert alert-warning" invisible="not agenda_over_budget">The estimated agenda exceeds the planned meeting duration.</div><button name="action_add_point" type="object" string="Add Point" class="btn-primary" invisible="state in ['approved','cancelled']"/><button name="action_refresh_carryovers" type="object" string="Refresh pending points" invisible="not series_id or state not in ['draft','scheduled']"/></field>
            <xpath expr="//field[@name='agenda_item_ids']/list/field[@name='name']" position="after"><field name="priority" optional="hide"/><field name="estimated_minutes" optional="hide"/><field name="review_next_meeting" optional="show"/></xpath>
        </field>
    </record>
    <record id="view_series_preparation" model="ir.ui.view">
        <field name="name">community.meeting.series.preparation</field><field name="model">community.meeting.series</field><field name="inherit_id" ref="view_community_meeting_series_form"/>
        <field name="arch" type="xml"><field name="carryover_policy" position="after"><field name="duration_hours" widget="float_time"/><field name="attendee_partner_ids" widget="many2many_tags"/><field name="meeting_name_pattern" placeholder="{date} {series}"/><field name="followup_allowed_kinds" widget="many2many_tags"/><field name="followup_default_kind"/><field name="default_activity_type_id"/></field></field>
    </record>

<record id="view_meeting_create_wizard" model="ir.ui.view">
<field name="name">community.meeting.create.wizard</field><field name="model">community.meeting.create.wizard</field>
<field name="arch" type="xml"><form string="Prepare a Meeting">
<header><field name="step" widget="statusbar"/></header>
<group invisible="step != 'series'"><field name="company_id" invisible="1"/><field name="defaults_applied" invisible="1"/><field name="last_default_duration" invisible="1"/><field name="last_default_attendee_ids" invisible="1"/><field name="series_id" domain="[('company_id','=',company_id)]"/><p>Choose a series, or leave it empty for a standalone meeting. Your edits are kept when changing series.</p><button name="action_use_series_defaults" type="object" string="Use series defaults" invisible="not series_id"/></group>
<group invisible="step != 'when'"><field name="suggested_name" invisible="1"/><field name="start_datetime"/><field name="name" placeholder="2026-10-16 Weekly series"/><field name="duration_hours" widget="float_time"/></group>
<group invisible="step != 'people'"><field name="attendee_partner_ids" widget="many2many_tags"/></group>
<group invisible="step != 'carryover'"><p invisible="carry_line_ids" class="text-muted">There are no points to carry over into this meeting.</p><p invisible="not carry_line_ids">Review the points to continue. Accept to include a point, Postpone to keep it for a later meeting, or Discard to drop it (it will not be offered again).</p><field name="carry_line_ids" nolabel="1" invisible="not carry_line_ids"><list editable="bottom" create="0" delete="0"><field name="decision" widget="radio" options="{'horizontal': True}"/><field name="name"/><field name="origin_meeting_id"/><field name="reason"/></list></field></group>
<group invisible="step != 'agenda'"><button name="action_add_point" type="object" string="Add Point" class="btn-primary"/><field name="line_ids" readonly="1" domain="[('included','=',True)]"><list create="0" delete="0"><field name="name"/><field name="topic_id"/><field name="agenda_type_id"/><field name="priority"/></list></field></group>
<group invisible="step != 'review'"><p class="text-muted">Confirm the full result before creating the meeting.</p><field name="review_summary" nolabel="1" readonly="1"/></group>
<footer><button name="action_back" type="object" string="Back" invisible="step == 'series'"/><button name="action_next" type="object" string="Next" class="btn-primary" invisible="step == 'review'"/><button name="action_finish" type="object" string="Create Meeting" class="btn-primary" invisible="step != 'review'"/><button string="Cancel" special="cancel"/></footer>
</form></field></record>
<record id="view_point_wizard" model="ir.ui.view"><field name="name">community.meeting.point.wizard</field><field name="model">community.meeting.point.wizard</field>
<field name="arch" type="xml"><form string="Add a point" class="o_meeting_point_wizard">
<field name="meeting_id" invisible="1"/><field name="creation_wizard_id" invisible="1"/><field name="series_id" invisible="1"/><field name="company_id" invisible="1"/><field name="propose" invisible="1"/><field name="proposal_series_id" invisible="not propose" domain="[('company_id', '=', company_id), ('active', '=', True)]"/>
<div class="o_meeting_point_context text-muted" invisible="not meeting_id"><i class="fa fa-calendar-o" aria-hidden="true"/> Adding to <field name="meeting_id" readonly="1" nolabel="1" options="{'no_open': True}"/></div>
<div class="oe_title" invisible="topic_id"><label for="name" string="What is this point about?"/><h1><field name="name" placeholder="A clear one-line title"/></h1></div>
<group invisible="topic_id"><field name="agenda_type_id" widget="meeting_agenda_type"/></group>
<div class="o_meeting_point_help text-muted" invisible="topic_id">Explain the subject so any attendee can follow it. Add the links or documents needed to act on it.</div>
<field name="description" widget="html" invisible="topic_id"/>
<group invisible="topic_id"><group string="Planning"><field name="priority"/><field name="deadline"/><field name="estimated_minutes"/></group></group>
<group><field name="presenter_partner_id"/></group>
<field name="presenter_loaded" invisible="1"/>
<group invisible="topic_id"><field name="more_options" widget="boolean_toggle"/></group>
<group string="More options" invisible="not more_options and not topic_id">
    <field name="topic_id" options="{'no_create': True}" domain="[('company_id', '=', company_id), ('series_id', '=', series_id)]"/>
    <field name="origin_topic_id" invisible="not origin_topic_id"/>
    <field name="related_topic_ids" widget="many2many_tags" domain="[('company_id', '=', company_id), ('id', '!=', topic_id)]"/>
    <field name="followup_allowed_kinds" widget="many2many_tags"/>
    <field name="followup_default_kind"/>
</group>
<footer>
    <button name="action_save" type="object" string="Add point" class="btn-primary"/>
    <button name="action_save_another" type="object" string="Add and continue" invisible="context.get('from_live')"/>
    <button name="action_cancel" type="object" string="Cancel"/>
</footer>
</form></field></record>
<record id="action_prepare_meeting" model="ir.actions.act_window"><field name="name">New Meeting</field><field name="res_model">community.meeting.create.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
<menuitem id="menu_prepare_meeting" name="New Meeting" parent="menu_community_meetings_root" action="action_prepare_meeting" sequence="5" groups="group_meeting_editor"/>
<record id="menu_community_meeting_carryovers" model="ir.ui.menu"><field name="active" eval="False"/></record>
<record id="view_guided_meeting_list" model="ir.ui.view"><field name="name">community.meeting.guided.list</field><field name="model">community.meeting</field><field name="inherit_id" ref="view_community_meeting_list"/><field name="arch" type="xml"><xpath expr="//list" position="attributes"><attribute name="js_class">community_meeting_list</attribute></xpath></field></record>
<record id="view_followup_action_form" model="ir.ui.view"><field name="name">community.meeting.action.form</field><field name="model">community.meeting.action</field><field name="arch" type="xml"><form string="Follow-up"><sheet><h1><field name="name"/></h1><group><field name="meeting_id" readonly="1"/><field name="agenda_item_id" readonly="1"/><field name="followup_kind"/><field name="followup_activity_type_id" invisible="followup_kind != 'activity'"/><field name="followup_activity_completed_on" readonly="1"/><field name="responsible_user_ids" widget="many2many_tags"/><field name="deadline"/><field name="state"/><field name="completed_on" readonly="1"/></group><field name="description" widget="html"/></sheet><chatter/></form></field></record>
<record id="view_meeting_settings_followups" model="ir.ui.view"><field name="name">meeting.settings.followups</field><field name="model">res.config.settings</field><field name="inherit_id" ref="base.res_config_settings_view_form"/><field name="arch" type="xml"><xpath expr="//form" position="inside"><app name="community_meetings" string="Meetings" groups="base.group_system"><block title="Follow-ups"><setting string="Default follow-up type"><field name="followup_allowed_kinds" widget="many2many_tags"/><field name="followup_default_kind"/><field name="meeting_default_activity_type_id" invisible="followup_default_kind != 'activity'"/></setting></block><block title="Points"><setting string="Default point estimate (minutes)"><field name="meeting_estimated_minutes"/></setting></block><block title="Role names"><setting string="Coordination and secretary"><field name="meeting_coordinator_label"/><field name="meeting_secretary_label"/></setting></block></app></xpath></field></record>
</odoo>
