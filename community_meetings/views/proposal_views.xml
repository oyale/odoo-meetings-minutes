<odoo>
    <record id="action_propose_point" model="ir.actions.act_window">
        <field name="name">Propose a point</field>
        <field name="res_model">community.meeting.point.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_propose': True}</field>
    </record>
    <menuitem id="menu_propose_point" name="Propose a point" parent="community_meetings.menu_community_meetings_root" action="action_propose_point" sequence="20" groups="base.group_user"/>
    <record id="view_series_pending_proposals" model="ir.ui.view">
        <field name="name">community.meeting.series.pending.proposals</field>
        <field name="model">community.meeting.series</field>
        <field name="inherit_id" ref="community_meetings.view_community_meeting_series_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="alert alert-info" groups="community_meetings.group_meeting_editor" invisible="not pending_proposal_ids">
                    <strong>Proposals to review</strong>
                    <field name="pending_proposal_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0">
                            <field name="name"/>
                            <field name="proposer_partner_id"/>
                            <field name="priority"/>
                            <button name="action_accept_proposal" type="object" string="Accept"/>
                            <button name="action_reject_proposal" type="object" string="Reject"/>
                        </list>
                    </field>
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_proposal_group_policy_list" model="ir.ui.view">
        <field name="name">community.meeting.proposal.group.policy.list</field>
        <field name="model">community.meeting.proposal.group.policy</field>
        <field name="arch" type="xml">
            <list><field name="group_id"/><field name="active" widget="boolean_toggle"/></list>
        </field>
    </record>
    <record id="view_proposal_group_policy_form" model="ir.ui.view">
        <field name="name">community.meeting.proposal.group.policy.form</field>
        <field name="model">community.meeting.proposal.group.policy</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="group_id"/><field name="active"/></group>
                <div class="text-muted">When any authorized group is listed, only members of these groups (and meeting managers) may propose points. Leave empty so every internal user can propose.</div>
            </sheet></form>
        </field>
    </record>
    <record id="action_proposal_group_policy" model="ir.actions.act_window">
        <field name="name">Authorized Proposer Groups</field>
        <field name="res_model">community.meeting.proposal.group.policy</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_proposal_group_policy" name="Authorized Proposer Groups" parent="community_meetings.menu_community_meeting_configuration" action="action_proposal_group_policy" sequence="20" groups="community_meetings.group_meeting_manager"/>
</odoo>
