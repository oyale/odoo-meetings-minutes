<odoo>
    <record id="view_community_meeting_kind_list" model="ir.ui.view">
        <field name="name">community.meeting.kind.list</field>
        <field name="model">community.meeting.kind</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="sequence, name">
                <field name="sequence" widget="handle"/><field name="name"/><field name="code"/><field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_community_meeting_kind_form" model="ir.ui.view">
        <field name="name">community.meeting.kind.form</field>
        <field name="model">community.meeting.kind</field>
        <field name="arch" type="xml">
            <form string="Meeting Kind"><sheet><group><field name="name"/><field name="code"/><field name="sequence"/><field name="active"/></group>
                <div class="text-muted">Kinds are shared across all meetings. Once a kind is used, its code is fixed.</div>
            </sheet></form>
        </field>
    </record>
    <record id="action_community_meeting_kinds" model="ir.actions.act_window">
        <field name="name">Meeting Kinds</field><field name="res_model">community.meeting.kind</field><field name="view_mode">list,form</field>
    </record>
</odoo>
