<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="webclient_document_language" inherit_id="web.webclient_bootstrap">
        <xpath expr="//t[@t-call='web.layout']" position="inside">
            <t t-set="html_data" t-value="dict(html_data or {}, lang=request.env.user.lang.replace('_', '-'))"/>
        </xpath>
    </template>
</odoo>
