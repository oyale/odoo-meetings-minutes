<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_report_meeting_revision" model="ir.actions.report">
        <field name="name">Approved Meeting Minutes</field>
        <field name="model">community.meeting.revision</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">community_meetings.report_revision_document</field>
        <field name="report_file">community_meetings.report_revision_document</field>
        <field name="binding_model_id" ref="model_community_meeting_revision"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(6, 0, [ref('group_meeting_reader'), ref('group_meeting_editor'), ref('group_meeting_manager'), ref('group_meeting_approver')])]"/>
    </record>
    <template id="report_revision_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc['revision']"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-call="community_meetings.report_revision_content"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <template id="report_revision_content">
        <div class="o_meeting_minutes_document">
            <h2><span t-out="doc['meeting']['name']"/> <small><span t-out="doc['meeting']['code']"/></small></h2>
            <p t-if="doc.get('draft')" class="alert alert-warning"><strong>Draft — not approved.</strong> This preview reflects current saved meeting data.</p>
            <p t-else="">Revision <span t-out="doc['revision'].revision_number"/> · Approved by <span t-out="doc['snapshot']['approval']['approver']"/> on <span t-out="doc['snapshot']['approval']['approved_at']"/></p>
            <p><strong>Company:</strong> <span t-out="doc['meeting']['company']"/> · <strong>Organizer:</strong> <span t-out="doc['meeting']['organizer']"/></p>
            <p><strong>Secretary:</strong> <span t-out="doc['meeting']['secretary']"/> · <strong>Attendees:</strong> <span t-out="', '.join(doc['meeting']['attendees'])"/></p>
            <p><span t-out="doc['meeting']['start_datetime']"/> <span t-out="doc['meeting']['location']"/></p>
            <div t-if="doc['description']"><h3>Description</h3><p t-if="doc.get('draft')" class="text-muted">Source: meeting purpose in the meeting form.</p><div t-out="doc['description']"/></div>
            <h3>Agenda and discussion</h3>
            <p t-if="doc.get('draft')" class="text-muted">Source: agenda points and their discussion notes.</p>
            <t t-foreach="doc['agenda']" t-as="item">
                <h4><span t-out="item['sequence']"/>. <span t-out="item['name']"/> (<span t-out="item['kind']"/>)</h4>
                <p t-if="doc.get('draft')" class="text-muted">Source: agenda point, agreement and discussion records.</p>
                <div t-if="item['description_html']" t-out="item['description_html']"/>
                <div t-if="item['discussion_html']" t-out="item['discussion_html']"/>
                <p t-if="item['disposition']">Disposition: <span t-out="item['disposition']"/> <span t-out="item['deferral_reason']"/></p>
                <p t-if="item['decision_result_label']">Decision: <span t-out="item['decision_result_label']"/></p>
                <div t-foreach="item['resolutions']" t-as="resolution"><strong t-out="resolution['title']"/><div t-out="resolution['body_html']"/></div>
            </t>
            <div t-if="doc['general_resolutions']"><h3>Meeting-wide resolutions</h3><p t-if="doc.get('draft')" class="text-muted">Source: meeting-wide agreements.</p><div t-foreach="doc['general_resolutions']" t-as="resolution"><strong t-out="resolution['title']"/><div t-out="resolution['body_html']"/></div></div>
            <div t-if="doc['minutes_notes']"><h3>Minutes</h3><p t-if="doc.get('draft')" class="text-muted">Source: Meeting notes in the form or live screen.</p><div t-out="doc['minutes_notes']"/></div>
            <h3>Follow-up actions</h3>
            <p t-if="doc.get('draft')" class="text-muted">Source: follow-up records linked to this meeting.</p>
            <ul><li t-foreach="doc['actions']" t-as="action"><span t-out="action['name']"/> — <span t-out="', '.join(action.get('responsibles', [])) or action['responsible']"/> — <span t-out="action['deadline']"/> (<span t-out="action['state']"/>)</li></ul>
            <div t-if="doc['dissents']"><h3>Dissents and reservations</h3><p t-if="doc.get('draft')" class="text-muted">Source: dissents marked for inclusion in the minutes.</p><div t-foreach="doc['dissents']" t-as="dissent"><strong t-out="dissent['kind']"/> · <span t-out="dissent['author']"/> · <span t-out="dissent['scope']"/><div t-out="dissent['body_html']"/></div></div>
            <div t-if="doc['snapshot'].get('carryovers')"><h3>Carryover</h3><p t-if="doc.get('draft')" class="text-muted">Source: meeting carryover records.</p><ul><li t-foreach="doc['snapshot']['carryovers']" t-as="carry"><span t-out="carry['origin_name']"/> — <span t-out="carry['status']"/> — <span t-out="carry['reason']"/><t t-if="carry.get('destination_series', {}).get('name')"> — <span t-out="carry['destination_series']['name']"/></t><t t-if="carry.get('destination')"> / <span t-out="carry['destination']"/></t></li></ul></div>
            <p t-if="not doc.get('draft')" class="text-muted">Snapshot SHA-256: <span t-out="doc['revision'].snapshot_sha256"/></p>
        </div>
    </template>
    <template id="report_revision_preview">
        <div class="o_meeting_minutes_preview"><t t-call="community_meetings.report_revision_content"/></div>
    </template>
</odoo>
