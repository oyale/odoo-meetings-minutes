<odoo>
    <record id="action_report_meeting_revision" model="ir.actions.report">
        <field name="name">Approved Meeting Minutes</field>
        <field name="model">community.meeting.revision</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">community_meetings.report_revision_document</field>
        <field name="report_file">community_meetings.report_revision_document</field>
        <field name="binding_model_id" ref="model_community_meeting_revision"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(6, 0, [ref('group_meeting_reader'), ref('group_meeting_editor'), ref('group_meeting_manager'), ref('group_meeting_approver')])]"/>
    </record>
    <template id="report_revision_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc['revision']"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2><span t-esc="doc['meeting']['name']"/> <small><span t-esc="doc['meeting']['code']"/></small></h2>
                        <p>Revision <span t-esc="doc['revision'].revision_number"/> · Approved by <span t-esc="doc['snapshot']['approval']['approver']"/> on <span t-esc="doc['snapshot']['approval']['approved_at']"/></p>
                        <p><strong>Company:</strong> <span t-esc="doc['meeting']['company']"/> · <strong>Organizer:</strong> <span t-esc="doc['meeting']['organizer']"/></p>
                        <p><strong>Secretary:</strong> <span t-esc="doc['meeting']['secretary']"/> · <strong>Attendees:</strong> <span t-esc="', '.join(doc['meeting']['attendees'])"/></p>
                        <p><span t-esc="doc['meeting']['start_datetime']"/> <span t-esc="doc['meeting']['location']"/></p>
                        <div t-if="doc['description']"><h3>Description</h3><div t-out="doc['description']"/></div>
                        <h3>Agenda and discussion</h3>
                        <t t-foreach="doc['agenda']" t-as="item">
                            <h4><span t-esc="item['sequence']"/>. <span t-esc="item['name']"/> (<span t-esc="item['kind']"/>)</h4>
                            <div t-if="item['description_html']" t-out="item['description_html']"/>
                            <div t-if="item['discussion_html']" t-out="item['discussion_html']"/>
                            <p t-if="item['disposition']">Disposition: <span t-esc="item['disposition']"/> <span t-esc="item['deferral_reason']"/></p>
                            <p t-if="item['decision_result_label']">Decision: <span t-esc="item['decision_result_label']"/></p>
                            <div t-foreach="item['resolutions']" t-as="resolution"><strong t-esc="resolution['title']"/><div t-out="resolution['body_html']"/></div>
                        </t>
                        <div t-if="doc['general_resolutions']"><h3>Meeting-wide resolutions</h3><div t-foreach="doc['general_resolutions']" t-as="resolution"><strong t-esc="resolution['title']"/><div t-out="resolution['body_html']"/></div></div>
                        <div t-if="doc['minutes_notes']"><h3>Minutes</h3><div t-out="doc['minutes_notes']"/></div>
                        <h3>Follow-up actions</h3>
                        <ul><li t-foreach="doc['actions']" t-as="action"><span t-esc="action['name']"/> — <span t-esc="action['responsible']"/> — <span t-esc="action['deadline']"/> (<span t-esc="action['state']"/>)</li></ul>
                        <div t-if="doc['dissents']"><h3>Dissents and reservations</h3><div t-foreach="doc['dissents']" t-as="dissent"><strong t-esc="dissent['kind']"/> · <span t-esc="dissent['author']"/> · <span t-esc="dissent['scope']"/><div t-out="dissent['body_html']"/></div></div>
                        <div t-if="doc['snapshot']['carryovers']"><h3>Carryover</h3><ul><li t-foreach="doc['snapshot']['carryovers']" t-as="carry"><span t-esc="carry['origin_name']"/> — <span t-esc="carry['status']"/> — <span t-esc="carry['reason']"/></li></ul></div>
                        <p class="text-muted">Snapshot SHA-256: <span t-esc="doc['revision'].snapshot_sha256"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
