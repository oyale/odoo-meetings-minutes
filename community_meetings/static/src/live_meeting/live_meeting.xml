<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="community_meetings.LiveMeeting">
        <main class="o_community_live_meeting">
            <div class="o_live_topbar">
                <button class="btn btn-secondary" t-att-disabled="state.saving > 0" t-on-click="close">Back to Meetings</button>
                <div class="o_live_workflow_buttons">
                  <t t-if="state.capabilities?.can_edit">
                    <button t-if="state.meeting.state === 'scheduled' and !state.meeting.actual_start_datetime" class="btn btn-primary" t-att-disabled="state.submitting['meeting:' + meetingId]" t-on-click="startMeeting">Start Meeting</button>
                    <button t-if="state.meeting.state === 'scheduled' and state.meeting.actual_start_datetime and !meetingPaused" class="btn btn-outline-secondary" t-att-disabled="state.submitting['meeting:' + meetingId]" t-on-click="pauseMeeting">Pause Meeting</button>
                    <button t-if="state.meeting.state === 'scheduled' and meetingPaused" class="btn btn-primary" t-att-disabled="state.submitting['meeting:' + meetingId]" t-on-click="resumeMeeting">Resume Meeting</button>
                    <button t-if="state.meeting.state === 'scheduled' and state.meeting.actual_start_datetime" class="btn btn-primary" t-att-disabled="state.submitting['meeting:' + meetingId]" t-on-click="markHeld">Finish Meeting</button>
                    <button t-if="state.meeting.state === 'scheduled' and !state.meeting.actual_start_datetime" class="btn btn-outline-secondary" t-att-disabled="state.submitting['meeting:' + meetingId]" t-on-click="markHeld">Record as Already Held</button>
                    <button t-if="state.meeting.state === 'held'" class="btn btn-primary" t-att-disabled="state.submitting['meeting:' + meetingId]" t-on-click="prepareMinutes">Prepare Minutes</button>
                  </t>
                    <button t-if="state.meeting.state === 'minutes_draft' and canApproveMinutes" class="btn btn-primary" t-att-disabled="state.saving > 0 or state.submitting['meeting:' + meetingId]" t-on-click="approveMinutes">Approve Minutes</button>
                </div>
                <span t-if="state.saving" class="text-muted" role="status" aria-live="polite">Saving…</span>
                <span t-elif="state.saveError" class="text-danger" role="alert">Some changes could not be saved.<t t-if="state.saveErrorDetail"> <t t-out="state.saveErrorDetail"/></t> Retry by editing the affected field.</span>
                <span t-elif="hasUnsavedEditors" class="text-warning" role="status" aria-live="polite">Changes pending</span>
                <span t-else="" class="text-success" role="status" aria-live="polite">All changes saved</span>
                <span t-if="state.meeting.state" class="badge text-bg-primary"><t t-out="stateLabel(state.meeting.state)"/></span>
            </div>
            <t t-if="state.loading"><div class="text-muted p-4">Loading meeting…</div></t>
            <t t-else="">
                <header class="o_live_header">
                    <div>
                        <div class="text-muted"><t t-out="state.meeting.code"/></div>
                        <h1><t t-if="locked" t-out="state.meeting.name"/><input t-else="" class="form-control fs-2" aria-label="Meeting name" t-att-value="state.headerDraft.name ?? (state.meeting.name || '')" t-on-input="(ev) => { state.headerDraft.name = ev.target.value; }" t-on-change="(ev) => this.saveHeaderField('name', ev.target.value)"/></h1>
                    </div>
                    <div class="o_live_header_details">
                        <div><strong>Estimated start</strong><span><t t-out="dateTime(state.meeting.start_datetime)"/></span></div>
                        <div><strong>Estimated end</strong><span><t t-out="dateTime(state.meeting.end_datetime)"/></span></div>
                        <div><strong>Estimated duration</strong><span t-out="durationLabel(state.meeting.duration_minutes)"/></div>
                        <div><strong>Actual start</strong><span><t t-out="dateTime(state.meeting.actual_start_datetime)"/></span></div>
                        <div><strong>Actual end</strong><span><t t-out="dateTime(state.meeting.actual_end_datetime)"/></span></div>
                        <div t-if="state.meeting.actual_end_datetime"><strong>Actual duration</strong><span t-out="durationLabel(state.meeting.actual_duration_minutes)"/></div>
                        <div><strong t-out="state.meeting.coordinator_role_label || 'Organizer'"/><span><t t-out="label(state.meeting.organizer_id)"/></span></div>
                        <div><strong t-out="state.meeting.secretary_role_label || 'Minutes secretary'"/><span t-if="locked" t-out="label(state.meeting.secretary_id)"/><select t-else="" class="form-select" aria-label="Minutes secretary" t-on-change="(ev) => this.saveHeaderField('secretary_id', ev.target.value)"><option value="">Not set</option><option t-foreach="state.users" t-as="user" t-key="user.id" t-att-value="user.id" t-att-selected="state.meeting.secretary_id?.[0] === user.id"><t t-out="user.name"/></option></select></div>
                        <div><strong>Location</strong><span t-if="locked" t-out="state.meeting.location || 'Not set'"/><input t-else="" class="form-control" aria-label="Location" t-att-value="state.headerDraft.location ?? (state.meeting.location || '')" t-on-input="(ev) => { state.headerDraft.location = ev.target.value; }" t-on-change="(ev) => this.saveHeaderField('location', ev.target.value)"/></div>
                        <div><strong>Meeting link</strong><a t-if="locked" t-att-href="state.meeting.meeting_url" t-out="state.meeting.meeting_url"/><input t-else="" class="form-control" type="url" aria-label="Meeting link" t-att-value="state.headerDraft.meeting_url ?? (state.meeting.meeting_url || '')" t-on-input="(ev) => { state.headerDraft.meeting_url = ev.target.value; }" t-on-change="(ev) => this.saveHeaderField('meeting_url', ev.target.value)"/></div>
                        <div class="o_live_attendees"><strong>Attendees</strong><span><t t-out="attendees()"/></span>
                            <button t-if="!locked and !state.attendeeEditorOpen" class="btn btn-link btn-sm" t-on-click="toggleAttendeeEditor">Edit attendees</button>
                        </div>
                    </div>
                    <div t-if="state.attendeeEditorOpen" class="o_live_attendee_editor">
                        <fieldset t-if="state.attendees.length" class="o_live_selected_attendees">
                            <legend>Selected attendees</legend>
                            <label t-foreach="state.attendees" t-as="partner" t-key="partner.id" class="form-check">
                                <input class="form-check-input" type="checkbox" t-att-checked="state.attendeeIds.includes(partner.id)" t-on-change="() => this.toggleAttendee(partner.id)"/>
                                <span class="form-check-label"><t t-out="partner.name"/></span>
                            </label>
                        </fieldset>
                        <label class="form-label" for="attendee-search">Find contacts</label>
                        <input id="attendee-search" class="form-control" type="search" t-att-value="state.attendeeSearch" t-on-input="(ev) => this.searchPartners(ev.target.value)"/>
                        <div class="o_live_attendee_options">
                            <label t-foreach="state.partnerResults" t-as="partner" t-key="partner.id" class="form-check">
                                <input class="form-check-input" type="checkbox" t-att-checked="state.attendeeIds.includes(partner.id)" t-on-change="() => this.toggleAttendee(partner.id)"/>
                                <span class="form-check-label"><t t-out="partner.name"/></span>
                            </label>
                            <p t-if="state.attendeeSearch and !state.partnerResults.length" class="text-muted">No matching contacts.</p>
                        </div>
                        <div class="o_live_add_row">
                            <button class="btn btn-primary" t-att-disabled="state.saving > 0" t-on-click="saveAttendees">Save attendees</button>
                            <button class="btn btn-link" t-on-click="toggleAttendeeEditor">Cancel</button>
                        </div>
                    </div>
                    <a t-if="state.meeting.meeting_url" t-att-href="state.meeting.meeting_url" target="_blank" rel="noreferrer">Open meeting link</a>
                </header>

                <section t-if="state.incoming.length" class="alert alert-info o_live_incoming" aria-label="Points to continue">
                    <h2>Points to continue</h2>
                    <div t-foreach="state.incoming" t-as="transfer" t-key="transfer.id" class="mb-2">
                        <strong t-out="transfer.origin_name"/> <span t-out="label(transfer.origin_meeting_id)"/>
                        <p t-if="transfer.reason" t-out="transfer.reason"/>
                        <button class="btn btn-success" t-on-click="() => this.reviewCarryover(transfer, true)">Accept</button>
                        <button class="btn btn-outline-secondary" t-on-click="() => this.reviewCarryover(transfer, false)">Dismiss</button>
                    </div>
                </section>
                <section class="o_live_agenda">
                    <div class="o_live_section_title">
                        <div><h2>Agenda</h2><span class="text-muted"><t t-out="completedCount"/> of <t t-out="state.items.length"/> points completed</span></div>
                        <div class="o_live_agenda_tools"><button t-if="!locked" class="btn btn-primary" t-on-click="addPoint">Add Point</button>
                            <button class="btn btn-outline-secondary" t-att-disabled="!visibleItems.length" t-on-click="() => this.navigateItem(-1)" title="Previous point" aria-label="Previous agenda point"><i class="fa fa-arrow-up" aria-hidden="true"/></button>
                            <button class="btn btn-outline-secondary" t-att-disabled="!visibleItems.length" t-on-click="() => this.navigateItem(1)" title="Next point" aria-label="Next agenda point"><i class="fa fa-arrow-down" aria-hidden="true"/></button>
                            <button class="btn btn-outline-secondary" t-att-aria-pressed="state.showPendingOnly" t-on-click="togglePending">Pending only</button>
                            <button class="btn btn-outline-secondary" t-att-disabled="!visibleItems.length" t-on-click="toggleAll">Expand / Collapse all</button>
                        </div>
                    </div>
                    <t t-if="!state.items.length"><p class="text-muted">There are no agenda points in this meeting.</p></t>
                    <t t-elif="!visibleItems.length"><p class="text-muted">There are no pending agenda points.</p></t>
                    <article t-foreach="visibleItems" t-as="item" t-key="item.id" t-att-id="'agenda-card-' + item.id" t-att-class="'o_live_agenda_card ' + (state.activeItemId === item.id ? 'o_live_current' : '')">
                        <div class="o_live_card_header">
                            <button class="o_live_expand" t-on-click="() => this.toggle(item)" t-att-aria-expanded="state.expanded[item.id] ? 'true' : 'false'" t-att-aria-controls="'agenda-panel-' + item.id">
                                <i t-att-class="state.expanded[item.id] ? 'fa fa-chevron-down' : 'fa fa-chevron-right'" aria-hidden="true"/>
                                <span class="o_live_item_title"><t t-out="item.name"/></span>
                                <span t-if="state.activeItemId === item.id" class="visually-hidden">Current agenda point</span>
                            </button>
                            <span t-if="!state.editingTypes[item.id] or !item.actual_started_at" class="badge text-bg-light o_live_type_badge"><t t-out="label(item.agenda_type_id)"/></span>
                            <button t-if="item.actual_started_at and !readOnly and !state.editingTypes[item.id]" class="btn btn-link o_live_type_edit" t-on-click="() => this.toggleTypeEditor(item)" title="Change point type" aria-label="Change point type"><i class="fa fa-pencil" aria-hidden="true"/></button>
                            <select t-if="state.editingTypes[item.id] and item.actual_started_at" class="form-select o_live_type" t-att-value="item.agenda_type_id[0]" t-att-disabled="readOnly" t-on-change="(ev) => this.updateItem(item, 'agenda_type_id', ev.target.value)" aria-label="Point type">
                                <option t-foreach="state.types" t-as="type" t-key="type.id" t-att-value="type.id" t-att-disabled="!type.active"><t t-out="type.name"/><t t-if="!type.active"> (archived)</t></option>
                            </select>
                            <span t-if="item.priority !== '1'" t-att-class="'o_live_priority o_live_priority_' + item.priority" t-att-title="priorityLabel(item)" t-att-aria-label="priorityLabel(item)"><i class="fa fa-flag" aria-hidden="true"/><span class="visually-hidden" t-out="priorityLabel(item)"/></span>
                            <span class="badge o_live_outcome_badge" t-att-class="outcomeBadgeClass(item)"><t t-out="pointOutcomeLabel(item)"/></span>
                            <div t-if="!readOnly and state.meeting.actual_start_datetime and !state.meeting.actual_end_datetime and canStartPoint(item)" class="o_live_point_timer">
                                <span t-if="item.actual_started_at" class="badge text-bg-success">Point in progress</span>
                                <span t-elif="item.has_started" class="badge text-bg-secondary">Point paused</span>
                                <button t-if="!item.actual_started_at" class="btn btn-sm btn-outline-primary" t-on-click="(ev) => { ev.stopPropagation(); this.startPoint(item); }"><t t-if="item.has_started">Resume point</t><t t-else="">Begin point</t></button>
                                <button t-if="item.actual_started_at" class="btn btn-sm btn-outline-secondary" t-on-click="(ev) => { ev.stopPropagation(); this.pausePoint(item); }">Pause point</button>
                            </div>
                        </div>
                        <div t-att-id="'agenda-panel-' + item.id" t-att-class="'o_live_card_body ' + (state.expanded[item.id] ? '' : 'd-none')">
                            <details t-if="item.description" class="o_live_planned" open="open"><summary>Planned topic</summary><div t-out="safeHtml(item.description)"/></details>
                            <div t-if="item.has_started or draftingMinutes" class="o_live_subsection o_live_discussion_notes">
                                <label class="form-label" t-att-for="'discussion-' + item.id">Discussion notes</label>
                                <t t-if="canEditDiscussion(item)"><div class="o_live_richtext"><t t-component="Wysiwyg" t-props="{ options: richTextOptions(item.discussion_notes, 'discussion_notes:' + item.id, 'community.meeting.agenda.item', item.id, 'discussion_notes'), editingValue: item.discussion_notes || '', startWysiwyg: richTextStarter('discussion_notes:' + item.id, item.id, 'community.meeting.agenda.item', 'discussion_notes') }"/></div></t>
                                <t t-else=""><div class="o_live_rich_readonly" t-out="safeHtml(item.discussion_notes)"/></t>
                            </div>
                            <div t-if="typeBehavior(item) === 'next_meeting'" class="o_live_subsection o_live_next_meeting">
                                <label class="form-label" t-att-for="'next-date-' + item.id">Next meeting date</label>
                                <input type="datetime-local" class="form-control" t-att-id="'next-date-' + item.id" aria-label="Next meeting date" t-att-value="nextMeetingLocalValue(item)" t-att-disabled="readOnly" t-on-change="(ev) => this.setNextMeetingDate(item, ev.target.value)"/>
                                <span class="text-muted" t-out="state.capabilities.timezone"/>
                            </div>
                            <div t-if="typeBehavior(item) === 'minutes_approval'" class="o_live_subsection o_live_minutes_approval">
                                <label class="form-label">Pending minutes to approve</label>
                                <ul t-if="state.pendingMinutes.length" class="list-unstyled mb-0">
                                    <li t-foreach="state.pendingMinutes" t-as="pm" t-key="pm.id" class="d-flex align-items-center gap-2">
                                        <span><t t-out="pm.code"/> — <t t-out="pm.name"/> (<t t-out="stateLabel(pm.state)"/>)</span>
                                        <button class="btn btn-sm btn-link p-0" t-on-click="() => this.openMeeting(pm.id)" aria-label="Open minutes">Review</button>
                                    </li>
                                </ul>
                                <p t-if="!state.pendingMinutes.length" class="text-muted mb-0">No pending minutes.</p>
                            </div>
                            <div class="text-muted o_live_point_meta"><span t-if="item.presenter_partner_id">Proposed by <t t-out="label(item.presenter_partner_id)"/> · </span><span t-if="item.deadline">Due <t t-out="item.deadline"/> · </span><span t-if="item.estimated_minutes">Estimated <t t-out="item.estimated_minutes"/> min</span></div>
                            <details t-if="item.actual_started_at and !readOnly" class="o_live_advanced"><summary>Point options</summary><button class="btn btn-link" t-on-click="() => this.editPoint(item)">Edit point details</button></details>
                            <t t-if="item.has_started">
                              <t t-if="item.actual_started_at and !readOnly">

                            <div t-if="item.is_followup" class="alert alert-light">Follow-up of a closed point: <t t-out="item.topic_outcome"/></div>
                            <div t-if="!item.is_followup" class="o_live_point_actions" role="group" aria-label="Change agenda point result">
                                <button t-if="!readOnly and !item.is_followup and item.disposition !== 'open' and !state.reopening[item.id]" class="btn btn-outline-secondary" t-on-click="() => { state.reopening[item.id] = ''; }" aria-label="Undo point result"><i class="fa fa-undo" aria-hidden="true"/> Undo result</button>
                            </div>
                            <div t-if="!readOnly and state.reopening[item.id] !== undefined" class="o_live_reopen_form">
                                <label class="form-label" t-att-for="'reopen-reason-' + item.id">Why reopen this point? (optional)</label>
                                <input t-att-id="'reopen-reason-' + item.id" class="form-control" t-att-value="state.reopening[item.id]" t-on-input="(ev) => this.setReopenReason(item, ev.target.value)"/>
                                <button class="btn btn-primary" t-att-disabled="state.submitting['reopen:' + item.id]" t-on-click="() => this.reopenPoint(item)">Reopen point</button>
                                <button class="btn btn-link" t-on-click="() => delete state.reopening[item.id]">Cancel</button>
                            </div>
                            <div t-if="item.disposition === 'deferred'" class="mt-3"><strong>Postponed</strong><p t-if="item.deferral_reason" t-out="item.deferral_reason"/></div>
                            <h3>Agreements and resolutions</h3>
                            <div class="o_live_record_actions" role="group" aria-label="Add meeting records">
                                <button t-if="!readOnly and !state.panels[item.id]?.agreement and (typeBehavior(item) !== 'decision' or !decisionAgreement(item))" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.togglePanel(item, 'agreement')"><i class="fa fa-handshake-o" aria-hidden="true"/> Add agreement</button>
                                <button t-if="!readOnly and !state.panels[item.id]?.dissent" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.togglePanel(item, 'dissent')"><i class="fa fa-comment-o" aria-hidden="true"/> Add dissent</button>
                            </div>
                            <div class="o_live_subsection">
                                <div class="o_live_record_list" t-if="pointDissents(item).length">
                                <ul t-if="pointDissents(item).length" class="o_live_inline_records">
                                    <li t-foreach="pointDissents(item)" t-as="dissent" t-key="dissent.id" class="o_live_record_editor">
                                        <input class="form-control" aria-label="Author" placeholder="Author" t-att-value="dissent.author_display_name || ''" t-att-disabled="readOnly" t-on-change="(ev) => this.updateDissent(dissent, 'author_display_name', ev.target.value || false)"/>
                                        <select class="form-select" aria-label="Statement type" t-att-value="dissent.reason_id?.[0]" t-att-disabled="readOnly" t-on-change="(ev) => this.updateDissent(dissent, 'reason_id', Number(ev.target.value))">
                                            <option t-foreach="state.dissentReasons" t-as="reason" t-key="reason.id" t-att-value="reason.id"><t t-out="reason.name"/></option>
                                        </select>
                                        <label class="form-check-label"><input class="form-check-input" type="checkbox" t-att-checked="dissent.include_in_minutes" t-att-disabled="readOnly" t-on-change="(ev) => this.updateDissent(dissent, 'include_in_minutes', ev.target.checked)"/> Include in minutes</label>
                                        <div t-if="locked or !state.editingRecords['dissent-' + dissent.id]" class="o_live_rich_readonly" t-out="safeHtml(dissent.body)"/>
                                        <t t-else=""><t t-component="Wysiwyg" t-props="{ options: richTextOptions(dissent.body, 'dissent:' + dissent.id, 'community.meeting.dissent', dissent.id, 'body'), editingValue: dissent.body || '', startWysiwyg: richTextStarter('dissent:' + dissent.id, dissent.id, 'community.meeting.dissent', 'body') }"/></t>
                                        <button t-if="!readOnly" class="btn btn-link" t-on-click="() => this.toggleRecordEditor('dissent-' + dissent.id)"><t t-if="state.editingRecords['dissent-' + dissent.id]">Done editing</t><t t-else="">Edit statement</t></button>
                                    </li>
                                </ul>
                                <p t-else="" class="text-muted">No dissent recorded.</p>
                                </div>
                                <div t-if="!readOnly and state.panels[item.id]?.dissent" class="o_live_add_row o_live_dissent_form">
                                    <input class="form-control" aria-label="Dissent author" placeholder="Name of the person expressing the dissent (optional)" t-att-value="state.newDissent[item.id]?.author_display_name || ''" t-on-input="(ev) => this.setDissent(item, 'author_display_name', ev.target.value)"/>
                                    <select class="form-select" aria-label="Dissent reason" t-att-value="state.newDissent[item.id]?.reason_id || (state.dissentReasons[0]?.id || '')" t-on-change="(ev) => this.setDissent(item, 'reason_id', Number(ev.target.value))"><option t-foreach="state.dissentReasons" t-as="reason" t-key="reason.id" t-att-value="reason.id"><t t-out="reason.name"/></option></select>
                                    <textarea class="form-control" aria-label="Dissent statement" rows="2" placeholder="Record a dissent or reservation…" t-att-value="state.newDissent[item.id]?.body || ''" t-on-input="(ev) => this.setDissent(item, 'body', ev.target.value)"/>
                                    <label class="form-check-label"><input class="form-check-input" type="checkbox" t-att-checked="state.newDissent[item.id]?.include_in_minutes !== false" t-on-change="(ev) => this.setDissent(item, 'include_in_minutes', ev.target.checked)"/> Include in minutes</label>
                                    <button class="btn btn-outline-primary" t-att-disabled="state.submitting['dissent:' + item.id]" t-on-click="() => this.addDissent(item)">Add dissent</button>
                                    <button class="btn btn-link" t-on-click="() => this.togglePanel(item, 'dissent')">Cancel</button>
                                </div>
                            </div>
                            <div class="o_live_subsection">
                                <div t-foreach="pointResolutions(item)" t-as="resolution" t-key="resolution.id" class="o_live_resolution_editor">
                                    <strong class="o_live_agreement_title"><t t-out="resolution.title"/></strong>
                                    <span t-if="resolution.decision_outcome and resolution.status === 'active'" class="badge" t-att-class="resolution.decision_outcome === 'approved' ? 'text-bg-success' : 'text-bg-danger'"><t t-if="resolution.decision_outcome === 'approved'">Approved</t><t t-else="">Rejected</t> decision</span>
                                    <span t-elif="resolution.decision_outcome" class="badge text-bg-light">Withdrawn — <t t-if="resolution.decision_outcome === 'approved'">previously approved</t><t t-else="">previously rejected</t></span>
                                    <span t-else="" class="badge text-bg-light"><t t-out="resolution.status"/></span>
                                    <button t-if="!readOnly and resolution.decision_outcome and resolution.status === 'active'" class="btn btn-outline-secondary" t-on-click="() => this.withdrawDecisionAgreement(item, resolution)">Withdraw decision agreement</button>
                                    <button t-if="!readOnly and !resolution.decision_outcome" class="btn btn-link" t-on-click="() => this.requestRecordCarryover('community.meeting.resolution', resolution)">Follow up at another meeting</button>
                                    <div t-if="locked or !state.editingRecords['resolution-' + resolution.id]" class="o_live_rich_readonly" t-out="safeHtml(resolution.body)"/>
                                    <t t-else=""><t t-component="Wysiwyg" t-props="{ options: richTextOptions(resolution.body, 'resolution:' + resolution.id, 'community.meeting.resolution', resolution.id, 'body'), editingValue: resolution.body || '', startWysiwyg: richTextStarter('resolution:' + resolution.id, resolution.id, 'community.meeting.resolution', 'body') }"/></t>
                                    <button t-if="!readOnly and !resolution.decision_outcome" class="btn btn-link" t-on-click="() => this.toggleRecordEditor('resolution-' + resolution.id)"><t t-if="state.editingRecords['resolution-' + resolution.id]">Done editing</t><t t-else="">Edit agreement</t></button>
                                </div>
                                <div t-if="!readOnly and state.panels[item.id]?.agreement" class="o_live_add_row o_live_resolution_form">
                                    <input t-att-id="'agreement-title-' + item.id" class="form-control" aria-label="Agreement title" placeholder="Agreement title" t-att-value="state.newResolution[item.id]?.title || ''" t-on-input="(ev) => this.setResolution(item, 'title', ev.target.value)"/>
                                    <select t-if="typeBehavior(item) === 'decision'" class="form-select" aria-label="New decision result" t-att-value="newDecisionOutcome(item)" t-on-change="(ev) => this.setResolution(item, 'decision_outcome', ev.target.value)"><option value="">Decision pending</option><option value="approved">Approved</option><option value="denied">Rejected</option></select>
                                    <textarea class="form-control" rows="2" placeholder="What was agreed?" t-att-value="state.newResolution[item.id]?.body || ''" t-on-input="(ev) => this.setResolution(item, 'body', ev.target.value)"/>
                                    <button class="btn btn-outline-primary" t-att-disabled="state.submitting['resolution:' + item.id]" t-on-click="() => this.addResolution(item)">Add agreement</button>
                                    <button class="btn btn-link" t-on-click="() => this.togglePanel(item, 'agreement')">Cancel</button>
                                </div>
                            </div>
                            <details class="o_live_subsection">
                                <summary>Private editorial notes</summary>
                                <ul t-if="pointPrivateNotes(item).length" class="o_live_inline_records">
                                    <li t-foreach="pointPrivateNotes(item)" t-as="note" t-key="note.id" class="o_live_record_editor">
                                        <div t-if="!state.editingRecords['note-' + note.id]" class="o_live_rich_readonly" t-out="safeHtml(note.content)"/>
                                        <t t-else=""><t t-component="Wysiwyg" t-props="{ options: richTextOptions(note.content, 'note:' + note.id, 'community.meeting.editor.note', note.id, 'content'), editingValue: note.content || '', startWysiwyg: richTextStarter('note:' + note.id, note.id, 'community.meeting.editor.note', 'content') }"/></t>
                                        <button class="btn btn-link" t-on-click="() => this.toggleRecordEditor('note-' + note.id)"><t t-if="state.editingRecords['note-' + note.id]">Done editing</t><t t-else="">Edit private note</t></button>
                                    </li>
                                </ul>
                                <button t-if="!readOnly and !state.panels[item.id]?.privateNote" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.togglePanel(item, 'privateNote')">Add private note</button>
                                <div t-if="!readOnly and state.panels[item.id]?.privateNote" class="o_live_add_row">
                                    <textarea class="form-control" rows="2" aria-label="Private editorial note" placeholder="Add a private note for editors…" t-att-value="state.newPrivateNote[item.id] || ''" t-on-input="(ev) => this.setPrivateNote(item, ev.target.value)"/>
                                    <button class="btn btn-outline-secondary" t-att-disabled="state.submitting['private-note:' + item.id]" t-on-click="() => this.addPrivateNote(item)">Add private note</button>
                                    <button class="btn btn-link" t-on-click="() => this.togglePanel(item, 'privateNote')">Cancel</button>
                                </div>
                                <p class="text-muted">Private notes are excluded from approved minutes.</p>
                            </details>
                            <div class="o_live_subsection">
                                <h3>Follow-up tasks</h3>
                                <p t-if="typeBehavior(item) === 'todo' and item.disposition !== 'closed'" class="text-muted">A follow-up task must be recorded before this TODO can be resolved.</p>
                                <ul t-if="pointActions(item).length" class="o_live_inline_records">
                                    <li t-foreach="pointActions(item)" t-as="task" t-key="task.id" class="o_live_followup_task">
                                        <div class="o_live_followup_task_title">
                                            <label class="form-label" t-att-for="'live-task-name-' + task.id">Task</label>
                                            <input class="form-control" t-att-id="'live-task-name-' + task.id" aria-label="Task name" t-att-value="task.name" t-on-change="(ev) => this.updateAction(task, 'name', ev.target.value)"/>
                                            <div class="o_live_followup_badges"><span class="badge text-bg-light"><t t-out="followupKindLabel(task)"/></span><span t-if="task.followup_kind === 'activity' and actionActivityType(task)" class="badge text-bg-light"><t t-out="actionActivityType(task)"/></span><span class="badge text-bg-light"><t t-out="actionStateLabel(task.state)"/></span></div>
                                        </div>
                                        <div class="o_live_followup_task_fields">
                                            <span class="text-muted" t-if="task.responsible_user_ids?.length > 1"><t t-out="state.users.filter(person => task.responsible_user_ids.includes(person.id)).map(person => person.name).join(', ')"/></span>
                                            <details class="o_live_advanced"><summary>Several responsible people</summary><select multiple="multiple" class="form-select" aria-label="Responsible people" t-on-change="(ev) => this.updateActionOwners(task, this.selectedUserIds(ev))"><option t-foreach="state.users" t-as="person" t-key="person.id" t-att-value="person.id" t-att-selected="task.responsible_user_ids?.includes(person.id)"><t t-out="person.name"/></option></select></details>
                                            <label class="o_live_task_field"><span>Assigned to</span>
                                                <select class="form-select o_live_task_owner" aria-label="Task owner" t-att-value="task.responsible_user_id?.[0] || ''" t-on-change="(ev) => this.updateAction(task, 'responsible_user_id', ev.target.value)">
                                                    <option value="">Unassigned</option><option t-foreach="state.users" t-as="user" t-key="user.id" t-att-value="user.id"><t t-out="user.name"/></option>
                                                </select>
                                            </label>
                                            <label class="o_live_task_field"><span>Due date</span>
                                                <input class="form-control o_live_task_deadline" type="date" aria-label="Task deadline" t-att-value="task.deadline || ''" t-on-change="(ev) => this.updateAction(task, 'deadline', ev.target.value)"/>
                                            </label>
                                            <label class="o_live_task_field"><span>Status</span>
                                                <select class="form-select o_live_task_state" aria-label="Task status" t-att-value="task.state" t-on-change="(ev) => this.updateAction(task, 'state', ev.target.value)"><option value="open">Open</option><option value="in_progress">In progress</option><option value="done">Done</option><option value="cancelled">Cancelled</option></select>
                                            </label>
                                        </div>
                                        <button t-if="!readOnly and item.topic_state === 'open' and task.agenda_item_id?.[0] === item.id" class="btn btn-sm btn-outline-danger mt-2" t-on-click="() => this.deleteFollowup(item, task)" aria-label="Delete follow-up"><i class="fa fa-trash" aria-hidden="true"/> Delete follow-up</button>
                                    </li>
                                </ul>
                                <p t-else="" class="text-muted">No follow-up tasks.</p>
                                <button t-if="!readOnly and !state.panels[item.id]?.followup" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.togglePanel(item, 'followup')"><i class="fa fa-tasks" aria-hidden="true"/> Add follow-up</button>
                                <div t-if="!readOnly and state.panels[item.id]?.followup" class="o_live_add_row o_live_task_form">
                                    <label class="o_live_task_field"><span>Follow-up title</span><input class="form-control" aria-label="Task name" placeholder="Follow-up" t-att-value="state.newAction[item.id]?.name || ''" t-on-input="(ev) => this.setAction(item, 'name', ev.target.value)"/></label>
                                    <label class="o_live_task_field"><span>Follow-up type</span><select class="form-select" aria-label="Follow-up type" t-att-value="state.newAction[item.id]?.followup_kind || followupDefaults(item).kind" t-on-change="(ev) => this.setAction(item, 'followup_kind', ev.target.value)"><option t-foreach="followupChoices(item)" t-as="choice" t-key="choice.kind" t-att-value="choice.kind" t-att-selected="choice.kind === (state.newAction[item.id]?.followup_kind || followupDefaults(item).kind)"><t t-out="choice.label"/></option></select></label>
                                    <label t-if="(state.newAction[item.id]?.followup_kind || followupDefaults(item).kind) === 'activity'" class="o_live_task_field"><span>Activity type</span><select class="form-select" aria-label="Activity type" t-att-value="state.newAction[item.id]?.followup_activity_type_id || followupDefaults(item).activity_type_id || ''" t-on-change="(ev) => this.setAction(item, 'followup_activity_type_id', ev.target.value)"><option value="">Choose activity type</option><option t-foreach="state.activityTypes" t-as="activityType" t-key="activityType.id" t-att-value="activityType.id"><t t-out="activityType.name"/></option></select></label>
                                    <label class="o_live_task_field"><span>Assigned to</span><select class="form-select o_live_task_owner" aria-label="Task owner" t-att-value="state.newAction[item.id]?.responsible_user_id ?? state.defaultOwner" t-on-change="(ev) => this.setAction(item, 'responsible_user_id', ev.target.value)"><option value="">Unassigned</option><option t-foreach="state.users" t-as="user" t-key="user.id" t-att-value="user.id"><t t-out="user.name"/></option></select></label>
                                    <label class="o_live_task_field"><span>Due date</span><input class="form-control" type="date" aria-label="Deadline" t-att-value="state.newAction[item.id]?.deadline || ''" t-on-change="(ev) => this.setAction(item, 'deadline', ev.target.value)"/></label>
                                    <details class="o_live_advanced"><summary>Several responsible people</summary><label class="o_live_task_field"><span>Responsible people</span><select multiple="multiple" class="form-select" aria-label="Responsible people" t-on-change="(ev) => this.setAction(item, 'responsible_user_ids', this.selectedUserIds(ev))"><option t-foreach="state.users" t-as="person" t-key="person.id" t-att-value="person.id" t-att-selected="(state.newAction[item.id]?.responsible_user_ids || [state.defaultOwner]).includes(person.id)"><t t-out="person.name"/></option></select></label></details>
                                    <button class="btn btn-outline-primary" t-att-disabled="state.submitting['action:' + item.id]" t-on-click="() => this.addAction(item)">Add follow-up</button>
                                    <button class="btn btn-link" t-on-click="() => this.togglePanel(item, 'followup')">Cancel</button>
                                </div>
                            <label t-if="!readOnly" class="form-check-label"><input class="form-check-input" type="checkbox" aria-label="Review at next meeting" t-att-checked="item.review_next_meeting" t-att-disabled="state.submitting['review:' + item.id]" t-on-change="(ev) => this.toggleReview(item, ev.target.checked)"/> Review at next meeting</label>
                            <div t-if="state.deferrals[item.id]" class="o_live_subsection o_live_deferral">
                                <label class="form-label" t-att-for="'deferral-code-' + item.id">Quick reason</label>
                                <div t-att-id="'deferral-code-' + item.id" class="o_live_reason_choices" role="radiogroup" aria-label="Quick reason">
                                    <button t-foreach="deferralReasonChoices" t-as="choice" t-key="choice[0]" type="button"
                                            t-att-class="'btn btn-sm o_live_reason_choice ' + (state.deferrals[item.id].code === choice[0] ? 'btn-primary' : 'btn-outline-secondary')"
                                            t-att-aria-pressed="state.deferrals[item.id].code === choice[0]"
                                            t-on-click="() => this.setDeferralCode(item, choice[0])">
                                        <i t-attf-class="fa #{choice[2]} me-1" aria-hidden="true"/><t t-out="choice[1]"/>
                                    </button>
                                </div>
                                <label t-if="isBlockedReason(state.deferrals[item.id].code)" class="form-label mt-2" t-att-for="'deferral-blocked-' + item.id">Blocked by (optional)</label>
                                <select t-if="isBlockedReason(state.deferrals[item.id].code)" t-att-id="'deferral-blocked-' + item.id" class="form-select" aria-label="Blocked by" t-on-change="(ev) => this.setDeferralBlockedBy(item, ev.target.value)">
                                    <option value="">Not linked</option>
                                    <option t-foreach="deferralBlockedOptions(item)" t-as="option" t-key="option.value" t-att-value="option.value" t-att-selected="option.value === state.deferrals[item.id].blocked_by"><t t-out="option.label"/></option>
                                </select>
                                <label class="form-label mt-2" t-att-for="'deferral-' + item.id">Reason for postponing</label>
                                <textarea t-att-id="'deferral-' + item.id" class="form-control" rows="2" t-att-value="state.deferrals[item.id].reason" t-on-input="(ev) => this.setDeferralReason(item, ev.target.value)"/>
                                <div class="o_live_add_row mt-2">
                                    <button class="btn btn-primary" t-on-click="() => this.saveDeferral(item)">Leave postponed</button>
                                    <button class="btn btn-outline-primary" t-if="state.meeting.series_id" t-on-click="() => this.requestCarryover(item)"><i class="fa fa-exchange me-1" aria-hidden="true"/>Move to another meeting series</button>
                                    <button class="btn btn-outline-primary" t-if="!state.meeting.series_id" t-on-click="() => this.requestCarryover(item)"><i class="fa fa-exchange me-1" aria-hidden="true"/>Move to another meeting</button>
                                    <button class="btn btn-link" t-on-click="() => this.cancelDeferral(item)">Cancel</button>
                                </div>
                            </div>
                                <div class="o_live_point_footer" t-if="!readOnly">
                                    <button class="btn btn-primary" t-att-disabled="item.disposition === 'closed' or item.disposition === 'discussed' or !canCompletePoint(item)" t-on-click="() => this.completePoint(item)"><i class="fa fa-check" aria-hidden="true"/> Done</button>
                                    <button t-if="pointOutcome(item) !== 'deferred'" class="btn btn-outline-secondary" t-on-click="() => this.applyPointAction(item, 'deferred')" aria-label="Postpone agenda point"><i class="fa fa-clock-o" aria-hidden="true"/> Postpone</button>
                                    <span t-if="typeBehavior(item) === 'decision' and !decisionAgreement(item)" class="text-muted">Add an agreement and select approved or rejected before completing this point.</span>
                                    <span t-elif="typeBehavior(item) === 'todo' and !hasTodoAction(item)" class="text-muted">Add an assigned follow-up before completing this point.</span>
                                </div>
                            </div>
                              </t>
                              <div t-if="!item.actual_started_at or locked" class="o_live_paused_readonly" aria-label="Point details read only">
                                <span t-if="item.review_next_meeting" class="badge text-bg-info">Will be reviewed at the next meeting</span>
                                <p t-if="item.discussion_notes or pointDissents(item).length or pointResolutions(item).length or pointActions(item).length" class="text-muted">Live notes are saved. Resume this point to continue editing.</p>
                                <button t-if="!readOnly and state.meeting.actual_start_datetime and !state.meeting.actual_end_datetime and item.disposition !== 'open'" class="btn btn-outline-secondary" t-on-click="() => { state.reopening[item.id] = ''; }" aria-label="Undo point result"><i class="fa fa-undo" aria-hidden="true"/> Undo result</button>
                                <div t-if="!readOnly and state.reopening[item.id] !== undefined" class="o_live_reopen_form"><label class="form-label" t-att-for="'reopen-reason-paused-' + item.id">Why reopen this point? (optional)</label><input t-att-id="'reopen-reason-paused-' + item.id" class="form-control" t-att-value="state.reopening[item.id]" t-on-input="(ev) => this.setReopenReason(item, ev.target.value)"/><button class="btn btn-primary" t-att-disabled="state.submitting['reopen:' + item.id]" t-on-click="() => this.reopenPoint(item)">Reopen point</button></div>
                                <ul t-if="pointDissents(item).length" class="o_live_inline_records"><li t-foreach="pointDissents(item)" t-as="dissent" t-key="dissent.id"><strong><t t-out="dissent.author_display_name or 'Dissent'"/></strong><div class="o_live_rich_readonly" t-out="safeHtml(dissent.body)"/></li></ul>
                                <ul t-if="pointResolutions(item).length" class="o_live_inline_records"><li t-foreach="pointResolutions(item)" t-as="resolution" t-key="resolution.id"><strong t-out="resolution.title"/><div class="o_live_rich_readonly" t-out="safeHtml(resolution.body)"/></li></ul>
                                <ul t-if="pointActions(item).length" class="o_live_inline_records"><li t-foreach="pointActions(item)" t-as="task" t-key="task.id"><strong t-out="task.name"/> · <t t-out="actionStateLabel(task.state)"/></li></ul>
                              </div>
                            </t>
                        </div>
                    </article>
                </section>

                <section class="o_live_minutes">
                    <h2>Meeting notes</h2>
                    <t t-if="locked"><div class="o_live_rich_readonly" t-out="safeHtml(state.meeting.minutes_notes)"/></t>
                    <t t-else="">
                        <t t-component="Wysiwyg" t-props="{ options: richTextOptions(state.meeting.minutes_notes, 'minutes_notes', 'community.meeting', meetingId, 'minutes_notes'), editingValue: state.meeting.minutes_notes || '', startWysiwyg: richTextStarter('minutes_notes', meetingId, 'community.meeting', 'minutes_notes') }"/>
                    </t>
                </section>
            </t>
        </main>
    </t>
</templates>
