<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="community_meetings.LiveMeeting">
        <main class="o_community_live_meeting">
            <div class="o_live_topbar">
                <button class="btn btn-secondary" t-att-disabled="state.saving > 0" t-on-click="close">Back to Meetings</button>
                <div class="o_live_workflow_buttons">
                    <button t-if="state.meeting.state === 'scheduled' and !state.meeting.actual_start_datetime" class="btn btn-primary" t-att-disabled="state.submitting['meeting:' + meetingId]" t-on-click="startMeeting">Start Meeting</button>
                    <button t-if="state.meeting.state === 'scheduled' and state.meeting.actual_start_datetime" class="btn btn-primary" t-att-disabled="state.submitting['meeting:' + meetingId]" t-on-click="markHeld">Finish Meeting</button>
                    <button t-if="state.meeting.state === 'scheduled' and !state.meeting.actual_start_datetime" class="btn btn-outline-secondary" t-att-disabled="state.submitting['meeting:' + meetingId]" t-on-click="markHeld">Record as Already Held</button>
                    <button t-if="state.meeting.state === 'held'" class="btn btn-primary" t-att-disabled="state.submitting['meeting:' + meetingId]" t-on-click="prepareMinutes">Prepare Minutes</button>
                </div>
                <span t-if="state.saving" class="text-muted" role="status" aria-live="polite">Saving…</span>
                <span t-elif="state.saveError" class="text-danger" role="alert">Some changes could not be saved. Retry by editing the affected field.</span>
                <span t-elif="hasUnsavedEditors" class="text-warning" role="status" aria-live="polite">Changes pending</span>
                <span t-else="" class="text-success" role="status" aria-live="polite">All changes saved</span>
                <span t-if="state.meeting.state" class="badge text-bg-primary"><t t-out="stateLabel(state.meeting.state)"/></span>
            </div>
            <t t-if="state.loading"><div class="text-muted p-4">Loading meeting…</div></t>
            <t t-else="">
                <header class="o_live_header">
                    <div>
                        <div class="text-muted"><t t-out="state.meeting.code"/></div>
                        <h1><t t-out="state.meeting.name"/></h1>
                    </div>
                    <div class="o_live_header_details">
                        <div><strong>Planned start</strong><span><t t-out="dateTime(state.meeting.start_datetime)"/></span></div>
                        <div><strong>Planned end</strong><span><t t-out="dateTime(state.meeting.end_datetime)"/></span></div>
                        <div><strong>Duration</strong><span t-out="durationLabel(state.meeting.duration_minutes)"/></div>
                        <div><strong>Actual start</strong><span><t t-out="dateTime(state.meeting.actual_start_datetime)"/></span></div>
                        <div><strong>Actual end</strong><span><t t-out="dateTime(state.meeting.actual_end_datetime)"/></span></div>
                        <div><strong>Organizer</strong><span><t t-out="label(state.meeting.organizer_id)"/></span></div>
                        <div><strong>Location</strong><span><t t-out="state.meeting.location || 'Not set'"/></span></div>
                        <div class="o_live_attendees"><strong>Attendees</strong><span><t t-out="attendees()"/></span>
                            <button t-if="!locked and !state.attendeeEditorOpen" class="btn btn-link btn-sm" t-on-click="toggleAttendeeEditor">Edit attendees</button>
                        </div>
                    </div>
                    <div t-if="state.attendeeEditorOpen" class="o_live_attendee_editor">
                        <fieldset t-if="state.attendees.length" class="o_live_selected_attendees">
                            <legend>Selected attendees</legend>
                            <label t-foreach="state.attendees" t-as="partner" t-key="partner.id" class="form-check">
                                <input class="form-check-input" type="checkbox" t-att-checked="state.attendeeIds.includes(partner.id)" t-on-change="() => this.toggleAttendee(partner.id)"/>
                                <span class="form-check-label"><t t-out="partner.name"/></span>
                            </label>
                        </fieldset>
                        <label class="form-label" for="attendee-search">Find contacts</label>
                        <input id="attendee-search" class="form-control" type="search" t-att-value="state.attendeeSearch" t-on-input="(ev) => this.searchPartners(ev.target.value)"/>
                        <div class="o_live_attendee_options">
                            <label t-foreach="state.partnerResults" t-as="partner" t-key="partner.id" class="form-check">
                                <input class="form-check-input" type="checkbox" t-att-checked="state.attendeeIds.includes(partner.id)" t-on-change="() => this.toggleAttendee(partner.id)"/>
                                <span class="form-check-label"><t t-out="partner.name"/></span>
                            </label>
                            <p t-if="state.attendeeSearch and !state.partnerResults.length" class="text-muted">No matching contacts.</p>
                        </div>
                        <div class="o_live_add_row">
                            <button class="btn btn-primary" t-att-disabled="state.saving > 0" t-on-click="saveAttendees">Save attendees</button>
                            <button class="btn btn-link" t-on-click="toggleAttendeeEditor">Cancel</button>
                        </div>
                    </div>
                    <a t-if="state.meeting.meeting_url" t-att-href="state.meeting.meeting_url" target="_blank" rel="noreferrer">Open meeting link</a>
                </header>

                <section t-if="state.incoming.length" class="alert alert-info o_live_incoming" aria-label="Points to continue">
                    <h2>Points to continue</h2>
                    <div t-foreach="state.incoming" t-as="transfer" t-key="transfer.id" class="mb-2">
                        <strong t-out="transfer.origin_name"/> <span t-out="label(transfer.origin_meeting_id)"/>
                        <p t-if="transfer.reason" t-out="transfer.reason"/>
                        <button class="btn btn-success" t-on-click="() => this.reviewCarryover(transfer, true)">Accept</button>
                        <button class="btn btn-outline-secondary" t-on-click="() => this.reviewCarryover(transfer, false)">Dismiss</button>
                    </div>
                </section>
                <section class="o_live_agenda">
                    <div class="o_live_section_title">
                        <div><h2>Agenda</h2><span class="text-muted"><t t-out="completedCount"/> of <t t-out="state.items.length"/> points completed</span></div>
                        <div class="o_live_agenda_tools"><button t-if="!locked" class="btn btn-primary" t-on-click="addPoint">Add Point</button>
                            <button class="btn btn-outline-secondary" t-att-disabled="!visibleItems.length" t-on-click="() => this.navigateItem(-1)" title="Previous point" aria-label="Previous agenda point"><i class="fa fa-arrow-up" aria-hidden="true"/></button>
                            <button class="btn btn-outline-secondary" t-att-disabled="!visibleItems.length" t-on-click="() => this.navigateItem(1)" title="Next point" aria-label="Next agenda point"><i class="fa fa-arrow-down" aria-hidden="true"/></button>
                            <button class="btn btn-outline-secondary" t-att-aria-pressed="state.showPendingOnly" t-on-click="togglePending">Pending only</button>
                            <button class="btn btn-outline-secondary" t-att-disabled="!visibleItems.length" t-on-click="toggleAll">Expand / Collapse all</button>
                        </div>
                    </div>
                    <t t-if="!state.items.length"><p class="text-muted">There are no agenda points in this meeting.</p></t>
                    <t t-elif="!visibleItems.length"><p class="text-muted">There are no pending agenda points.</p></t>
                    <article t-foreach="visibleItems" t-as="item" t-key="item.id" t-att-id="'agenda-card-' + item.id" t-att-class="'o_live_agenda_card ' + (state.activeItemId === item.id ? 'o_live_current' : '')">
                        <div class="o_live_card_header">
                            <button class="o_live_expand" t-on-click="() => this.toggle(item)" t-att-aria-expanded="state.expanded[item.id] ? 'true' : 'false'" t-att-aria-controls="'agenda-panel-' + item.id">
                                <i t-att-class="state.expanded[item.id] ? 'fa fa-chevron-down' : 'fa fa-chevron-right'" aria-hidden="true"/>
                                <span class="o_live_item_title"><t t-out="item.name"/></span>
                                <span t-if="state.activeItemId === item.id" class="visually-hidden">Current agenda point</span>
                            </button>
                            <span t-if="!state.editingTypes[item.id]" class="badge text-bg-light o_live_type_badge"><t t-out="label(item.agenda_type_id)"/></span>
                            <button t-if="!locked and !state.editingTypes[item.id]" class="btn btn-link o_live_type_edit" t-on-click="() => this.toggleTypeEditor(item)" title="Change point type" aria-label="Change point type"><i class="fa fa-pencil" aria-hidden="true"/></button>
                            <select t-if="state.editingTypes[item.id]" class="form-select o_live_type" t-att-value="item.agenda_type_id[0]" t-att-disabled="locked" t-on-change="(ev) => this.updateItem(item, 'agenda_type_id', ev.target.value)" aria-label="Point type">
                                <option t-foreach="state.types" t-as="type" t-key="type.id" t-att-value="type.id" t-att-disabled="!type.active"><t t-out="type.name"/><t t-if="!type.active"> (archived)</t></option>
                            </select>
                            <span t-if="item.priority !== '1'" t-att-class="'o_live_priority o_live_priority_' + item.priority" t-att-title="priorityLabel(item)" t-att-aria-label="priorityLabel(item)"><i class="fa fa-flag" aria-hidden="true"/><span class="visually-hidden" t-out="priorityLabel(item)"/></span>
                            <span class="badge o_live_outcome_badge" t-att-class="outcomeBadgeClass(item)"><t t-out="pointOutcomeLabel(item)"/></span>
                        </div>
                        <div t-att-id="'agenda-panel-' + item.id" t-att-class="'o_live_card_body ' + (state.expanded[item.id] ? '' : 'd-none')">
                            <details t-if="item.description" class="o_live_planned" open="open"><summary>Planned topic</summary><div t-out="safeHtml(item.description)"/></details>
                            <details t-if="!locked" class="o_live_advanced"><summary>Point options</summary><button class="btn btn-link" t-on-click="() => this.editPoint(item)">Edit point details</button>
                                <input class="form-control" aria-label="Reason for reopening" placeholder="Reason for reopening" t-on-input="(ev) => { item.reopen_reason = ev.target.value; }"/>
                                <button class="btn btn-link" t-on-click="() => this.reopenPoint(item)">Reopen point</button>
                            </details>
                            <div class="text-muted o_live_point_meta"><span t-if="item.deadline">Due <t t-out="item.deadline"/> · </span><span t-if="item.estimated_minutes"><t t-out="item.estimated_minutes"/> min</span></div>
                            <label t-if="!locked" class="form-check-label"><input class="form-check-input" type="checkbox" aria-label="Review at next meeting" t-att-checked="item.review_next_meeting" t-on-change="(ev) => this.updateItem(item, 'review_next_meeting', ev.target.checked)"/> Review at next meeting</label>
                            <div t-if="item.is_followup" class="alert alert-light">Follow-up of a closed point: <t t-out="item.topic_outcome"/><button t-if="!locked" class="btn btn-outline-success" t-on-click="() => this.applyPointAction(item, 'discussed')">Review complete</button></div>
                            <div t-if="!item.is_followup" class="o_live_point_actions" role="group" aria-label="Change agenda point result">
                                <button t-if="!locked and typeBehavior(item) === 'information' and pointOutcome(item) !== 'discussed'" class="btn btn-outline-success" t-on-click="() => this.applyPointAction(item, 'discussed')" aria-label="Mark as done"><i class="fa fa-check" aria-hidden="true"/> Done</button>
                                <button t-if="!locked and typeBehavior(item) === 'discussion' and pointOutcome(item) !== 'closed'" class="btn btn-outline-success" t-on-click="() => this.applyPointAction(item, 'closed')" aria-label="Resolve discussion"><i class="fa fa-check-circle" aria-hidden="true"/> Resolve</button>
                                <button t-if="!locked and typeBehavior(item) === 'todo' and item.disposition !== 'closed'" class="btn btn-outline-success" t-att-disabled="!hasTodoAction(item)" t-on-click="() => this.applyPointAction(item, 'closed')" aria-label="Resolve TODO"><i class="fa fa-check-circle" aria-hidden="true"/> Resolve TODO</button>
                                <button t-if="!locked and typeBehavior(item) === 'decision' and !decisionAgreement(item)" class="btn btn-outline-success" t-on-click="() => this.applyPointAction(item, 'approved')" aria-label="Approve decision"><i class="fa fa-thumbs-up" aria-hidden="true"/> Approve</button>
                                <button t-if="!locked and typeBehavior(item) === 'decision' and !decisionAgreement(item)" class="btn btn-outline-danger" t-on-click="() => this.applyPointAction(item, 'denied')" aria-label="Reject decision"><i class="fa fa-thumbs-down" aria-hidden="true"/> Reject</button>
                                <button t-if="!locked and pointOutcome(item) !== 'deferred'" class="btn btn-outline-secondary" t-on-click="() => this.applyPointAction(item, 'deferred')" aria-label="Postpone agenda point"><i class="fa fa-clock-o" aria-hidden="true"/> Postpone</button>
                            </div>
                            <label class="form-label" t-att-for="'discussion-' + item.id">Discussion notes</label>
                            <t t-if="locked"><div class="o_live_rich_readonly" t-out="safeHtml(item.discussion_notes)"/></t>
                            <t t-else="">
                                <t t-component="Wysiwyg" t-props="{ options: richTextOptions(item.discussion_notes, 'discussion_notes:' + item.id, 'community.meeting.agenda.item', item.id, 'discussion_notes'), editingValue: item.discussion_notes, startWysiwyg: richTextStarter('discussion_notes:' + item.id, item.id, 'community.meeting.agenda.item', 'discussion_notes') }"/>
                            </t>
                            <div t-if="item.disposition === 'deferred'" class="mt-3"><strong>Postponed</strong><p t-if="item.deferral_reason" t-out="item.deferral_reason"/></div>
                            <div t-if="state.deferrals[item.id]" class="o_live_subsection o_live_deferral">
                                <label class="form-label" t-att-for="'deferral-' + item.id">Reason for postponing</label>
                                <textarea t-att-id="'deferral-' + item.id" class="form-control" rows="2" t-att-value="state.deferrals[item.id].reason" t-on-input="(ev) => this.setDeferralReason(item, ev.target.value)"/>
                                <div class="o_live_add_row mt-2">
                                    <button class="btn btn-primary" t-on-click="() => this.saveDeferral(item)">Leave postponed</button>
                                    <button class="btn btn-outline-primary" t-if="state.meeting.series_id" t-on-click="() => this.requestCarryover(item)">Request next meeting carryover</button>
                                    <button class="btn btn-outline-primary" t-if="!state.meeting.series_id" t-on-click="() => this.requestCarryover(item)">Choose destination meeting</button>
                                    <button class="btn btn-link" t-on-click="() => this.cancelDeferral(item)">Cancel</button>
                                </div>
                            </div>
                            <details class="o_live_subsection">
                                <summary>Dissents and reservations</summary>
                                <ul t-if="pointDissents(item).length" class="o_live_inline_records">
                                    <li t-foreach="pointDissents(item)" t-as="dissent" t-key="dissent.id" class="o_live_record_editor">
                                        <input class="form-control" aria-label="Author" placeholder="Author" t-att-value="dissent.author_display_name || ''" t-att-disabled="locked" t-on-change="(ev) => this.updateDissent(dissent, 'author_display_name', ev.target.value || false)"/>
                                        <select class="form-select" aria-label="Statement type" t-att-value="dissent.kind" t-att-disabled="locked" t-on-change="(ev) => this.updateDissent(dissent, 'kind', ev.target.value)">
                                            <option value="dissent">Dissent</option><option value="reservation">Reservation</option><option value="minority_opinion">Minority opinion</option>
                                        </select>
                                        <label class="form-check-label"><input class="form-check-input" type="checkbox" t-att-checked="dissent.include_in_minutes" t-att-disabled="locked" t-on-change="(ev) => this.updateDissent(dissent, 'include_in_minutes', ev.target.checked)"/> Include in minutes</label>
                                        <div t-if="locked or !state.editingRecords['dissent-' + dissent.id]" class="o_live_rich_readonly" t-out="safeHtml(dissent.body)"/>
                                        <t t-else=""><t t-component="Wysiwyg" t-props="{ options: richTextOptions(dissent.body, 'dissent:' + dissent.id, 'community.meeting.dissent', dissent.id, 'body'), editingValue: dissent.body, startWysiwyg: richTextStarter('dissent:' + dissent.id, dissent.id, 'community.meeting.dissent', 'body') }"/></t>
                                        <button t-if="!locked" class="btn btn-link" t-on-click="() => this.toggleRecordEditor('dissent-' + dissent.id)"><t t-if="state.editingRecords['dissent-' + dissent.id]">Done editing</t><t t-else="">Edit statement</t></button>
                                    </li>
                                </ul>
                                <p t-else="" class="text-muted">No dissent recorded.</p>
                                <div t-if="!locked" class="o_live_add_row o_live_dissent_form">
                                    <input class="form-control" aria-label="Dissent author" placeholder="Name of the person expressing the dissent (optional)" t-att-value="state.newDissent[item.id]?.author_display_name || ''" t-on-input="(ev) => this.setDissent(item, 'author_display_name', ev.target.value)"/>
                                    <select class="form-select" aria-label="Statement type" t-att-value="state.newDissent[item.id]?.kind || 'dissent'" t-on-change="(ev) => this.setDissent(item, 'kind', ev.target.value)"><option value="dissent">Dissent</option><option value="reservation">Reservation</option><option value="minority_opinion">Minority opinion</option></select>
                                    <textarea class="form-control" aria-label="Dissent statement" rows="2" placeholder="Record a dissent or reservation…" t-att-value="state.newDissent[item.id]?.body || ''" t-on-input="(ev) => this.setDissent(item, 'body', ev.target.value)"/>
                                    <label class="form-check-label"><input class="form-check-input" type="checkbox" t-att-checked="state.newDissent[item.id]?.include_in_minutes !== false" t-on-change="(ev) => this.setDissent(item, 'include_in_minutes', ev.target.checked)"/> Include in minutes</label>
                                    <button class="btn btn-outline-primary" t-att-disabled="state.submitting['dissent:' + item.id]" t-on-click="() => this.addDissent(item)">Add dissent</button>
                                </div>
                            </details>
                            <div class="o_live_subsection">
                                <h3>Agreements and resolutions</h3>
                                <div t-foreach="pointResolutions(item)" t-as="resolution" t-key="resolution.id" class="o_live_resolution_editor">
                                    <strong class="o_live_agreement_title"><t t-out="resolution.title"/></strong>
                                    <span t-if="resolution.decision_outcome and resolution.status === 'active'" class="badge" t-att-class="resolution.decision_outcome === 'approved' ? 'text-bg-success' : 'text-bg-danger'"><t t-if="resolution.decision_outcome === 'approved'">Approved</t><t t-else="">Rejected</t> decision</span>
                                    <span t-elif="resolution.decision_outcome" class="badge text-bg-light">Withdrawn — <t t-if="resolution.decision_outcome === 'approved'">previously approved</t><t t-else="">previously rejected</t></span>
                                    <span t-else="" class="badge text-bg-light"><t t-out="resolution.status"/></span>
                                    <button t-if="!locked and resolution.decision_outcome and resolution.status === 'active'" class="btn btn-outline-secondary" t-on-click="() => this.withdrawDecisionAgreement(item, resolution)">Withdraw decision agreement</button>
                                    <button t-if="!locked and !resolution.decision_outcome" class="btn btn-link" t-on-click="() => this.requestRecordCarryover('community.meeting.resolution', resolution)">Follow up at another meeting</button>
                                    <div t-if="locked or !state.editingRecords['resolution-' + resolution.id]" class="o_live_rich_readonly" t-out="safeHtml(resolution.body)"/>
                                    <t t-else=""><t t-component="Wysiwyg" t-props="{ options: richTextOptions(resolution.body, 'resolution:' + resolution.id, 'community.meeting.resolution', resolution.id, 'body'), editingValue: resolution.body, startWysiwyg: richTextStarter('resolution:' + resolution.id, resolution.id, 'community.meeting.resolution', 'body') }"/></t>
                                    <button t-if="!locked and !resolution.decision_outcome" class="btn btn-link" t-on-click="() => this.toggleRecordEditor('resolution-' + resolution.id)"><t t-if="state.editingRecords['resolution-' + resolution.id]">Done editing</t><t t-else="">Edit agreement</t></button>
                                </div>
                                <div t-if="!locked" class="o_live_add_row o_live_resolution_form">
                                    <input t-att-id="'agreement-title-' + item.id" class="form-control" aria-label="Agreement title" placeholder="Agreement title" t-att-value="state.newResolution[item.id]?.title || ''" t-on-input="(ev) => this.setResolution(item, 'title', ev.target.value)"/>
                                    <select t-if="typeBehavior(item) === 'decision'" class="form-select" aria-label="New decision result" t-att-value="newDecisionOutcome(item)" t-on-change="(ev) => this.setResolution(item, 'decision_outcome', ev.target.value)"><option value="">Decision pending</option><option value="approved">Approved</option><option value="denied">Rejected</option></select>
                                    <textarea class="form-control" rows="2" placeholder="What was agreed?" t-att-value="state.newResolution[item.id]?.body || ''" t-on-input="(ev) => this.setResolution(item, 'body', ev.target.value)"/>
                                    <button class="btn btn-outline-primary" t-att-disabled="state.submitting['resolution:' + item.id]" t-on-click="() => this.addResolution(item)">Add agreement</button>
                                </div>
                            </div>
                            <details class="o_live_subsection">
                                <summary>Private editorial notes</summary>
                                <ul t-if="pointPrivateNotes(item).length" class="o_live_inline_records">
                                    <li t-foreach="pointPrivateNotes(item)" t-as="note" t-key="note.id" class="o_live_record_editor">
                                        <div t-if="!state.editingRecords['note-' + note.id]" class="o_live_rich_readonly" t-out="safeHtml(note.content)"/>
                                        <t t-else=""><t t-component="Wysiwyg" t-props="{ options: richTextOptions(note.content, 'note:' + note.id, 'community.meeting.editor.note', note.id, 'content'), editingValue: note.content, startWysiwyg: richTextStarter('note:' + note.id, note.id, 'community.meeting.editor.note', 'content') }"/></t>
                                        <button class="btn btn-link" t-on-click="() => this.toggleRecordEditor('note-' + note.id)"><t t-if="state.editingRecords['note-' + note.id]">Done editing</t><t t-else="">Edit private note</t></button>
                                    </li>
                                </ul>
                                <div t-if="!locked" class="o_live_add_row">
                                    <textarea class="form-control" rows="2" aria-label="Private editorial note" placeholder="Add a private note for editors…" t-att-value="state.newPrivateNote[item.id] || ''" t-on-input="(ev) => this.setPrivateNote(item, ev.target.value)"/>
                                    <button class="btn btn-outline-secondary" t-att-disabled="state.submitting['private-note:' + item.id]" t-on-click="() => this.addPrivateNote(item)">Add private note</button>
                                </div>
                                <p class="text-muted">Private notes are excluded from approved minutes.</p>
                            </details>
                            <div class="o_live_subsection">
                                <h3>Follow-up tasks</h3>
                                <p t-if="typeBehavior(item) === 'todo' and item.disposition !== 'closed'" class="text-muted">A follow-up task must be recorded before this TODO can be resolved.</p>
                                <ul t-if="pointActions(item).length" class="o_live_inline_records">
                                    <li t-foreach="pointActions(item)" t-as="task" t-key="task.id">
                                        <input class="form-control" aria-label="Task name" t-att-value="task.name" t-on-change="(ev) => this.updateAction(task, 'name', ev.target.value)"/>
                                        <span class="badge text-bg-light"><t t-out="actionStateLabel(task.state)"/></span>
                                        <button t-if="task.followup_activity_id and !locked" class="btn btn-link" t-on-click="() => this.completeActivity(task)">Complete activity</button>
                                        <span t-if="task.deadline" class="text-muted">Due <t t-out="task.deadline"/></span>
                                        <select class="form-select o_live_task_owner" aria-label="Task owner" t-att-value="task.responsible_user_id?.[0] || ''" t-on-change="(ev) => this.updateAction(task, 'responsible_user_id', ev.target.value)">
                                            <option value="">Unassigned</option><option t-foreach="state.users" t-as="user" t-key="user.id" t-att-value="user.id"><t t-out="user.name"/></option>
                                        </select>
                                        <input class="form-control o_live_task_deadline" type="date" aria-label="Task deadline" t-att-value="task.deadline || ''" t-on-change="(ev) => this.updateAction(task, 'deadline', ev.target.value)"/>
                                        <select class="form-select o_live_task_state" aria-label="Task status" t-att-value="task.state" t-on-change="(ev) => this.updateAction(task, 'state', ev.target.value)"><option value="open">Open</option><option value="in_progress">In progress</option><option value="done">Done</option><option value="cancelled">Cancelled</option></select>
                                    </li>
                                </ul>
                                <p t-else="" class="text-muted">No follow-up tasks.</p>
                                <div t-if="!locked" class="o_live_add_row o_live_task_form">
                                    <input class="form-control" aria-label="Task name" placeholder="Task" t-att-value="state.newAction[item.id]?.name || ''" t-on-input="(ev) => this.setAction(item, 'name', ev.target.value)"/>
                                    <input class="form-control" type="date" aria-label="Deadline" t-att-value="state.newAction[item.id]?.deadline || ''" t-on-change="(ev) => this.setAction(item, 'deadline', ev.target.value)"/>
                                    <select class="form-select o_live_task_owner" aria-label="Task owner" t-att-value="state.newAction[item.id]?.responsible_user_id ?? state.defaultOwner" t-on-change="(ev) => this.setAction(item, 'responsible_user_id', ev.target.value)"><option value="">Unassigned</option><option t-foreach="state.users" t-as="user" t-key="user.id" t-att-value="user.id"><t t-out="user.name"/></option></select>
                                    <button class="btn btn-outline-primary" t-att-disabled="state.submitting['action:' + item.id]" t-on-click="() => this.addAction(item)">Add task</button>
                                </div>
                            </div>
                        </div>
                    </article>
                </section>

                <!-- Pending product decision: remove or restore meeting-wide records. -->
                <section t-if="false" class="o_live_general_records">
                    <h2>Meeting level records</h2>
                    <div class="o_live_subsection">
                        <h3>General agreements</h3>
                        <div t-foreach="generalResolutions" t-as="resolution" t-key="resolution.id" class="o_live_resolution_editor">
                            <input class="form-control" aria-label="Agreement title" t-att-value="resolution.title" t-on-change="(ev) => this.updateResolution(resolution, 'title', ev.target.value)"/>
                            <select class="form-select" aria-label="Agreement status" t-att-value="resolution.status" t-on-change="(ev) => this.updateResolution(resolution, 'status', ev.target.value)"><option value="active">Active</option><option value="superseded">Superseded</option><option value="withdrawn">Withdrawn</option></select>
                            <button class="btn btn-link" t-on-click="() => this.requestRecordCarryover('community.meeting.resolution', resolution)">Follow up at another meeting</button>
                            <div t-if="!state.editingRecords['resolution-' + resolution.id]" class="o_live_rich_readonly" t-out="safeHtml(resolution.body)"/>
                            <t t-else=""><t t-component="Wysiwyg" t-props="{ options: richTextOptions(resolution.body, 'resolution:' + resolution.id, 'community.meeting.resolution', resolution.id, 'body'), editingValue: resolution.body, startWysiwyg: richTextStarter('resolution:' + resolution.id, resolution.id, 'community.meeting.resolution', 'body') }"/></t>
                            <button class="btn btn-link" t-on-click="() => this.toggleRecordEditor('resolution-' + resolution.id)">Edit agreement</button>
                        </div>
                        <div t-if="!locked" class="o_live_add_row o_live_resolution_form">
                            <input class="form-control" aria-label="General agreement title" placeholder="Agreement title" t-att-value="state.newResolution.general?.title || ''" t-on-input="(ev) => this.setGeneralValue('newResolution', 'title', ev.target.value)"/>
                            <textarea class="form-control" rows="2" aria-label="General agreement" placeholder="What was agreed?" t-att-value="state.newResolution.general?.body || ''" t-on-input="(ev) => this.setGeneralValue('newResolution', 'body', ev.target.value)"/>
                            <button class="btn btn-outline-primary" t-att-disabled="state.submitting['resolution:general']" t-on-click="addGeneralResolution">Add agreement</button>
                        </div>
                    </div>
                    <div class="o_live_subsection">
                        <h3>General follow-up tasks</h3>
                        <div t-foreach="generalActions" t-as="task" t-key="task.id" class="o_live_general_task">
                            <input class="form-control" aria-label="Task name" t-att-value="task.name" t-on-change="(ev) => this.updateAction(task, 'name', ev.target.value)"/>
                            <select class="form-select o_live_task_owner" aria-label="Task owner" t-att-value="task.responsible_user_id?.[0] || ''" t-on-change="(ev) => this.updateAction(task, 'responsible_user_id', ev.target.value)"><option value="">Unassigned</option><option t-foreach="state.users" t-as="user" t-key="user.id" t-att-value="user.id"><t t-out="user.name"/></option></select>
                            <input class="form-control o_live_task_deadline" type="date" aria-label="Task deadline" t-att-value="task.deadline || ''" t-on-change="(ev) => this.updateAction(task, 'deadline', ev.target.value)"/>
                            <select class="form-select o_live_task_state" aria-label="Task status" t-att-value="task.state" t-on-change="(ev) => this.updateAction(task, 'state', ev.target.value)"><option value="open">Open</option><option value="in_progress">In progress</option><option value="done">Done</option><option value="cancelled">Cancelled</option></select>
                            <button t-if="!locked" class="btn btn-link" t-on-click="() => this.requestRecordCarryover('community.meeting.action', task)">Follow up at another meeting</button>
                        </div>
                        <div t-if="!locked" class="o_live_add_row">
                            <input class="form-control" aria-label="General task name" placeholder="Task" t-att-value="state.newAction.general?.name || ''" t-on-input="(ev) => this.setGeneralValue('newAction', 'name', ev.target.value)"/>
                            <select class="form-select o_live_task_owner" aria-label="Task owner" t-att-value="state.newAction.general?.responsible_user_id || ''" t-on-change="(ev) => this.setGeneralValue('newAction', 'responsible_user_id', ev.target.value)"><option value="">Unassigned</option><option t-foreach="state.users" t-as="user" t-key="user.id" t-att-value="user.id"><t t-out="user.name"/></option></select>
                            <input class="form-control o_live_task_deadline" type="date" aria-label="Task deadline" t-att-value="state.newAction.general?.deadline || ''" t-on-change="(ev) => this.setGeneralValue('newAction', 'deadline', ev.target.value)"/>
                            <button class="btn btn-outline-primary" t-att-disabled="state.submitting['action:general']" t-on-click="addGeneralAction">Add task</button>
                        </div>
                    </div>
                    <details class="o_live_subsection">
                        <summary>General dissent and reservations</summary>
                        <div t-foreach="generalDissents" t-as="dissent" t-key="dissent.id" class="o_live_record_editor">
                            <input class="form-control" aria-label="Author" placeholder="Author" t-att-value="dissent.author_display_name || ''" t-on-change="(ev) => this.updateDissent(dissent, 'author_display_name', ev.target.value || false)"/>
                            <select class="form-select" aria-label="Statement type" t-att-value="dissent.kind" t-on-change="(ev) => this.updateDissent(dissent, 'kind', ev.target.value)"><option value="dissent">Dissent</option><option value="reservation">Reservation</option><option value="minority_opinion">Minority opinion</option></select>
                            <label class="form-check-label"><input class="form-check-input" type="checkbox" t-att-checked="dissent.include_in_minutes" t-on-change="(ev) => this.updateDissent(dissent, 'include_in_minutes', ev.target.checked)"/> Include in minutes</label>
                            <div t-if="!state.editingRecords['dissent-' + dissent.id]" class="o_live_rich_readonly" t-out="safeHtml(dissent.body)"/>
                            <t t-else=""><t t-component="Wysiwyg" t-props="{ options: richTextOptions(dissent.body, 'dissent:' + dissent.id, 'community.meeting.dissent', dissent.id, 'body'), editingValue: dissent.body, startWysiwyg: richTextStarter('dissent:' + dissent.id, dissent.id, 'community.meeting.dissent', 'body') }"/></t>
                            <button class="btn btn-link" t-on-click="() => this.toggleRecordEditor('dissent-' + dissent.id)">Edit statement</button>
                        </div>
                        <div t-if="!locked" class="o_live_add_row">
                            <input class="form-control" aria-label="Dissent author" placeholder="Author" t-att-value="state.newDissent.general?.author_display_name || ''" t-on-input="(ev) => this.setGeneralValue('newDissent', 'author_display_name', ev.target.value)"/>
                            <select class="form-select" aria-label="Statement type" t-att-value="state.newDissent.general?.kind || 'dissent'" t-on-change="(ev) => this.setGeneralValue('newDissent', 'kind', ev.target.value)"><option value="dissent">Dissent</option><option value="reservation">Reservation</option><option value="minority_opinion">Minority opinion</option></select>
                            <textarea class="form-control" aria-label="General dissent" rows="2" placeholder="Record a dissent or reservation…" t-att-value="state.newDissent.general?.body || ''" t-on-input="(ev) => this.setGeneralValue('newDissent', 'body', ev.target.value)"/>
                            <label class="form-check-label"><input class="form-check-input" type="checkbox" t-att-checked="state.newDissent.general?.include_in_minutes !== false" t-on-change="(ev) => this.setGeneralValue('newDissent', 'include_in_minutes', ev.target.checked)"/> Include in minutes</label>
                            <button class="btn btn-outline-primary" t-att-disabled="state.submitting['dissent:general']" t-on-click="addGeneralDissent">Add statement</button>
                        </div>
                    </details>
                </section>
                <section class="o_live_minutes">
                    <h2>Meeting notes</h2>
                    <t t-if="locked"><div class="o_live_rich_readonly" t-out="safeHtml(state.meeting.minutes_notes)"/></t>
                    <t t-else="">
                        <t t-component="Wysiwyg" t-props="{ options: richTextOptions(state.meeting.minutes_notes, 'minutes_notes', 'community.meeting', meetingId, 'minutes_notes'), editingValue: state.meeting.minutes_notes, startWysiwyg: richTextStarter('minutes_notes', meetingId, 'community.meeting', 'minutes_notes') }"/>
                    </t>
                </section>
            </t>
        </main>
    </t>
</templates>
