<odoo>
    <record id="view_community_meeting_form_project" model="ir.ui.view">
        <field name="name">community.meeting.form.project.tasks</field>
        <field name="model">community.meeting</field>
        <field name="inherit_id" ref="community_meetings.view_community_meeting_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='agenda_item_ids']/list/field[@name='name']" position="after">
                <field name="project_task_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='resolution_ids']/list/field[@name='title']" position="after">
                <field name="project_task_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='action_ids']/list/field[@name='name']" position="after">
                <field name="project_task_ids" widget="many2many_tags" options="{'no_create': True}"/>
                <button name="action_create_project_task" type="object" string="Create Task" icon="fa-plus" invisible="parent.state == 'cancelled'"/>
            </xpath>
        </field>
    </record>

    <record id="view_community_meeting_carryover_wizard_project" model="ir.ui.view">
        <field name="name">community.meeting.carryover.wizard.project</field>
        <field name="model">community.meeting.carryover.wizard</field>
        <field name="inherit_id" ref="community_meetings.view_community_meeting_carryover_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reason']" position="after">
                <field name="selected_project_task_ids" widget="many2many_tags" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_community_meeting_carryover_project" model="ir.ui.view">
        <field name="name">community.meeting.carryover.form.project</field>
        <field name="model">community.meeting.carryover</field>
        <field name="inherit_id" ref="community_meetings.view_community_meeting_carryover_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin_context']" position="after">
                <field name="selected_project_task_ids" groups="community_meetings.group_meeting_editor"/>
            </xpath>
        </field>
    </record>

    <record id="view_community_meeting_project_task_wizard" model="ir.ui.view">
        <field name="name">community.meeting.project.task.wizard.form</field>
        <field name="model">community.meeting.project.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Project Task" class="o_meeting_project_task_wizard">
                <group>
                    <div class="o_meeting_wizard_intro"><h2>Link a project task</h2><p>Use an existing task or create one from this follow-up.</p></div>
                    <field name="action_id" invisible="1"/>
                    <group string="Follow-up context" name="followup_context">
                        <field name="followup_name" readonly="1"/>
                        <field name="followup_responsible_user_ids" widget="many2many_tags" readonly="1"/>
                        <field name="followup_deadline" readonly="1"/>
                    </group>
                    <group string="Choose an existing task" name="existing_task_choice">
                        <field name="existing_task_id" options="{'no_create':True}"/>
                    </group>
                    <group string="Create a new task" name="new_task_choice" invisible="existing_task_id">
                        <field name="name"/>
                    </group>
                    <field name="has_default_project" invisible="1"/>
                    <group string="Project" name="project_choice" invisible="existing_task_id">
                        <field name="project_id" readonly="1" invisible="not has_default_project or choose_another_project"/>
                        <field name="choose_another_project" invisible="not has_default_project"/>
                        <field name="project_id" invisible="has_default_project and not choose_another_project"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create and Link" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_community_meeting_project_task_links" model="ir.ui.view">
        <field name="name">community.meeting.project.task.links.form</field>
        <field name="model">community.meeting.project.task.links</field>
        <field name="arch" type="xml">
            <form string="Accessible Meeting Links" create="0" edit="0">
                <notebook>
                    <page string="Agenda Items"><field name="agenda_item_ids"><list create="0" edit="0"><field name="meeting_id"/><field name="sequence"/><field name="name"/></list></field></page>
                    <page string="Resolutions"><field name="resolution_ids"><list create="0" edit="0"><field name="meeting_id"/><field name="title"/><field name="status"/></list></field></page>
                    <page string="Follow-up Actions"><field name="action_ids"><list create="0" edit="0"><field name="meeting_id"/><field name="name"/><field name="responsible_user_id"/><field name="state"/></list></field></page>
                </notebook>
                <footer><button string="Close" special="cancel"/></footer>
            </form>
        </field>
    </record>

    <record id="view_task_form_community_meeting_links" model="ir.ui.view">
        <field name="name">project.task.form.community.meeting.links</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_view_community_meeting_links" type="object" string="Meeting Agenda Links" icon="fa-users"/>
            </xpath>
        </field>
    </record>

    <record id="view_series_wizard_project" model="ir.ui.view">
        <field name="name">community.meeting.series.wizard.project</field>
        <field name="model">community.meeting.series.wizard</field>
        <field name="inherit_id" ref="community_meetings.view_series_wizard"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='project_wizard_configuration']" position="replace">
                <div class="o_meeting_series_panel o_meeting_series_project_panel" invisible="step != 'structure'">
                    <div class="o_meeting_series_policy_header">
                        <label class="o_meeting_series_project_label" for="link_project"><strong>Link a project</strong><span>Keep this series connected to a project for its tasks and follow-ups.</span></label>
                        <field name="link_project" widget="boolean_toggle" nolabel="1"/>
                    </div>
                    <div class="o_meeting_series_project_options" invisible="not link_project">
                        <field name="new_project" widget="radio" options="{'horizontal': True}"/>
                        <field name="project_id" invisible="new_project" options="{'no_create': True}" domain="['|', ('company_id', '=', company_id), ('company_id', '=', False)]" placeholder="Choose a project"/>
                        <field name="new_project_name" invisible="not new_project" placeholder="Project name"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@name='project_wizard_review']" position="replace">
                <div class="o_meeting_series_panel o_meeting_series_project_panel" invisible="step != 'review' or not link_project">
                    <h3>Project link</h3>
                    <field name="link_project" readonly="1" invisible="1"/>
                    <field name="project_id" readonly="1" invisible="not link_project or new_project"/>
                    <field name="new_project" readonly="1" invisible="1"/>
                    <field name="new_project_name" readonly="1" invisible="not link_project or not new_project"/>
                </div>
            </xpath>
        </field>
    </record>
<record id="view_series_project_policy" model="ir.ui.view"><field name="name">community.meeting.series.project.policy</field><field name="model">community.meeting.series</field><field name="inherit_id" ref="community_meetings.view_community_meeting_series_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Follow-up and Task Policy"><group><field name="meeting_project_mode"/><field name="meeting_project_id"/><field name="meeting_todo_requirement"/><field name="meeting_task_scope"/></group></page></xpath></field></record>
<record id="view_meeting_settings" model="ir.ui.view"><field name="name">meeting.settings.project</field><field name="model">res.config.settings</field><field name="inherit_id" ref="community_meetings.view_meeting_settings_followups"/><field name="arch" type="xml"><xpath expr="//app[@name='community_meetings']" position="inside"><block title="Project task policy"><setting string="Task project"><field name="meeting_project_mode"/><field name="meeting_project_id"/></setting><setting string="Evidence required to close a TODO"><field name="meeting_todo_requirement"/></setting><setting string="Existing tasks"><field name="meeting_task_scope"/></setting></block></xpath></field></record>
</odoo>
